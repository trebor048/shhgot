    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\bpredibase[\\w.-]{0,20}\\s*[:=]\\s*[\"']?[a-zA-Z0-9_-]{20,}\\b"
    name: 'Predibase API Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
