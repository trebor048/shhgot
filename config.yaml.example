    regex: (?i)(secret|scrt)_address\s*[:=]\s*secret1[a-z0-9]{38,39}
    name: Secret Network Wallet Address
    priority: 2
    color: '#f28c28'
  - part: contents
    regex: (?i)(solana|sol)_address\s*[:=]\s*[1-9A-HJ-NP-Za-km-z]{43,44}
    name: Solana Wallet Address
    priority: 2
    color: '#a65ad9'
  - part: contents
    regex: (?i)(stacks|stx)_address\s*[:=]\s*S[P123][a-zA-Z0-9]{32,33}
    name: Stacks Wallet Address
    priority: 2
    color: '#8f67d5'
  - part: contents
    regex: (?i)(starknet|stark)_address\s*[:=]\s*0x[a-fA-F0-9]{63,64}
