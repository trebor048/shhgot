cleanup:
  max_disk_usage_mb: 750          # hard ceiling for the temp directory (default 5120)
  cleanup_threshold_mb: 500       # start evicting once usage passes this
  cleanup_interval_secs: 60       # how often the cleanup pass runs (default 30)

# Per-match-type append logs. Written one file per signature name.
match_log_dir: logs/matches       # default: logs/matches
match_log_enabled: true           # default: true


# Tokens GitHub reports as revoked (HTTP 401) are auto-removed from this file
# at every startup AND while running (a config.yaml.bak backup is written
# first). A 401 during a scan drops the token immediately so it is never
# retried.
github_access_tokens:
  - 'github_pat_YOUR_GITHUB_FINE_GRAINED_PAT_HERE'
  - 'ghp_YOUR_GITHUB_CLASSIC_TOKEN_HERE'

# ---------------------------------------------------------------------------
# Webhook delivery
# ---------------------------------------------------------------------------
# Left commented out because a Discord placeholder fails startup validation:
# the webhook ID must be numeric, so `YOUR_DISCORD_WEBHOOK_HERE` is rejected by
# ValidateDiscordWebhook before the scanner starts. Uncomment a line and paste
# a real URL, or point at an env var (values go through os.ExpandEnv):
#
#   webhook: '$SHHGIT_DISCORD_WEBHOOK'
#
# webhook: 'https://discord.com/api/webhooks/<numeric-id>/<token>'
# webhook_ai_tokens: 'https://discord.com/api/webhooks/<id>/<token>'   # AI-token match class
# webhook_crypto: 'https://discord.com/api/webhooks/<id>/<token>'      # crypto match class

# Body template POSTed to the webhook above. %s is replaced with the match text.
webhook_payload: |
  {
    "text": "%s"
  }

# NOTE: `webhook_queue` is parsed into core.WebhookQueueCfg but the live queue is
# still constructed with hardcoded defaults (1000 slots, 500ms rate limit,
# 300s dedupe window) in core/validators.go. Setting it has no effect today.
# webhook_queue:
#   enabled: true
#   queue_size: 1000
#   rate_limit_ms: 500
#   dedupe_window_sec: 300
#   file_output_enabled: false
#   output_file_path: ''

blacklisted_strings: [
  "AKIAIOSFODNN7EXAMPLE", "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY", "your-api-key-here", "your_api_key", "your_secret_key",
  "replace-me", "replace_me", "changeme", "change_me", "TODO", "FIXME", "PLACEHOLDER", "example.com", "example.org",
  "username:password", "user:pass", "admin:admin", "password123", "admin123", "test123", "demo123", "localhost",
  "127.0.0.1", "0.0.0.0", "fonts.googleapis.com", "maps.googleapis.com", "youtube.com", "fake", "demo",
  "example", "placeholder", "sample", "mock", "dummy", "tutorial", "docs",
  "letmein", "qwerty", "123456", "passwd", "pwd", "sshpass -p $SSH_PASS",
  "0000000000000000", "1111111111111111", "2222222222222222", "3333333333333333",
  "aaaaaaaaaaaaaaaa", "bbbbbbbbbbbbbbbb", "cccccccccccccccc", "dddddddddddddddd",
  "eeeeeeeeeeeeeeee", "ffffffffffffffff", "0123456789abcdef", "deadbeefdeadbeef",
  "test test test", "abandon abandon abandon", "zoo zoo zoo",
  "xprv9s21ZrQH143K3QTDL4LXw2F7HEK3wJUD2nW2nRk4stbPy6cq3jPPqjiChkVvvNKmPGJxWUtg6LnF5kejMRNNU3TGtRBeJgk33yuGBxrMPHi",
  "5HueCGU8rMjxEXxiPuD5BDku4MkFqeZyd4dZ1jvhTVqvbTLvyTJ"
]
blacklisted_extensions: [".exe", ".jpg", ".jpeg", ".png", ".gif", ".zip", ".tar.gz"]
blacklisted_paths: ["node_modules{sep}", "vendor{sep}"]
blacklisted_entropy_extensions: [".pem", "id_rsa", ".asc", ".ovpn", ".sqlite", ".log"]

# ═══════════════════════════════════════════════════════════════════════════
# SIGNATURES - focused set
#
# Scope: private keys, AI/LLM API keys, cloud & version-control tokens,
# database connection strings, finance/payment keys, crypto wallets and
# seeds, environment/credential files, and the config files that routinely
# carry secrets.
#
# How these rules are built:
#   * Every contents rule is anchored either on the credential's own format
#     (AKIA..., sk_live_..., hf_...) or on the config key that names it.
#     Context-free catch-alls match code and prose far more often than they
#     match a real secret.
#   * A trailing \b is deliberately omitted after a character class that
#     contains '-' or '_'. \b is a word/non-word boundary, so a key ending
#     in '-' or '_' followed by a quote or a space could never match.
#   * not_regex carries the false-positive guard. Go's engine is RE2 and has
#     no lookaround ((?!...)), so the broad pattern lives in regex and the
#     exclusion lives in not_regex.
#   * Values that are one repeated character ("0000...", "aaaa...") are
#     covered once, in blacklisted_strings, instead of in every rule.
#
# COLOR LEGEND (severity):
#   priority 3 = #FF0000  Critical
#   priority 2 = #FFA500  Medium
#   priority 1 = #FFFF00  Low
#   priority 0 = #808080  Info
# ═══════════════════════════════════════════════════════════════════════════
signatures:

  # ═══════════════════════════════════════════════════════════════════════
  # 1. AI / ML / LLM
  # ═══════════════════════════════════════════════════════════════════════

  - part: 'contents'
    regex: '\bsk-proj-[a-zA-Z0-9_-]{20,}'
    name: 'OpenAI Project API Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: '\bsk-svcacct-[a-zA-Z0-9_-]{48,}'
    name: 'OpenAI Service Account Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: '\bsk-[a-zA-Z0-9]{48}\b'
    name: 'OpenAI API Key (Legacy)'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: '\bsk-ant-(?:api03-)?[a-zA-Z0-9_-]{90,}'
    name: 'Anthropic Claude API Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: '\bAIza[0-9A-Za-z_-]{35}'
    name: 'Google AI Studio / Gemini API Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\bvertex[\\w.-]{0,20}\\s*[:=]\\s*[\"']?AIza[0-9A-Za-z_-]{35}"
    name: 'Google Vertex AI API Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\bmistral[\\w.-]{0,20}\\s*[:=]\\s*[\"']?[a-zA-Z0-9]{32,}\\b"
    name: 'Mistral AI API Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\bcohere[\\w.-]{0,20}\\s*[:=]\\s*[\"']?[a-zA-Z0-9_-]{40}\\b"
    name: 'Cohere API Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: '\bgsk_[A-Za-z0-9]{20,}\b'
    name: 'Groq / GroqCloud API Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: '\bxai-[a-zA-Z0-9]{75,}\b'
    name: 'xAI Grok API Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\bdeepseek[\\w.-]{0,20}\\s*[:=]\\s*[\"']?sk-[a-zA-Z0-9]{32,}\\b"
    name: 'DeepSeek API Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: '\bpplx-[a-zA-Z0-9]{32,}\b'
    name: 'Perplexity API Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: '\bsk-or-v1-[a-zA-Z0-9]{40,}\b'
    name: 'OpenRouter API Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\btogether(?:[\\w.-]{0,20})?\\s*[:=]\\s*[\"']?[a-f0-9]{64}\\b"
    name: 'Together AI / Together Inference API Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\bfireworks[\\w.-]{0,20}\\s*[:=]\\s*[\"']?[a-zA-Z0-9]{32,}\\b"
    name: 'Fireworks AI API Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: '\br8_[A-Za-z0-9]{20,}\b'
    name: 'Replicate API Token'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: '\bhf_[A-Za-z0-9]{34}\b'
    name: 'Hugging Face API Token'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\bstability[\\w.-]{0,20}\\s*[:=]\\s*[\"']?sk-[A-Za-z0-9]{20,60}\\b"
    name: 'Stability AI API Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\bai21[\\w.-]{0,20}\\s*[:=]\\s*[\"']?[a-zA-Z0-9_-]{32,}\\b"
    name: 'AI21 Labs API Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\baleph[\\w.-]{0,20}\\s*[:=]\\s*[\"']?[a-zA-Z0-9_-]{32,}\\b"
    name: 'Aleph Alpha API Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: '\bcsk-[A-Za-z0-9_-]{20,}'
    name: 'Cerebras / Cerebras Cloud API Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\bsambanova[\\w.-]{0,20}\\s*[:=]\\s*[\"']?[a-zA-Z0-9_-]{32,}\\b"
    name: 'SambaNova / SambaNova Cloud API Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\bfriendli[\\w.-]{0,20}\\s*[:=]\\s*[\"']?[a-zA-Z0-9_-]{20,}\\b"
    name: 'FriendliAI API Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\banyscale[\\w.-]{0,20}\\s*[:=]\\s*[\"']?[a-zA-Z0-9_-]{20,}\\b"
    name: 'Anyscale API Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\bmodal(?:[\\w.-]{0,20})?\\s*[:=]\\s*[\"']?(?:ak|as)-[a-zA-Z0-9_-]{20,}\\b"
    name: 'Modal / Modal Labs API Token'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\bbaseten[\\w.-]{0,20}\\s*[:=]\\s*[\"']?[a-zA-Z0-9._-]{20,}\\b"
    name: 'Baseten API Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: '\brpa_[A-Za-z0-9]{20,}'
    name: 'RunPod API Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\blambda[\\w.-]{0,20}\\s*[:=]\\s*[\"']?[a-zA-Z0-9_-]{20,}\\b"
    name: 'Lambda Labs API Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\bvast[\\w.-]{0,20}\\s*[:=]\\s*[\"']?[a-zA-Z0-9_-]{20,}\\b"
    name: 'Vast.ai API Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\blepton[\\w.-]{0,20}\\s*[:=]\\s*[\"']?[a-zA-Z0-9_-]{20,}\\b"
