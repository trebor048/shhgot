  - part: 'contents'
    regex: '(azure_key|azurekey|azure-key|azure_secret|azuresecret|azure-secret)\s*[:=]\s*["\x27]([^\"\x27]{20,})["\x27]'
    name: 'Azure Credentials in Quotes'
    priority: 3
    color: '#d53d46'

  # Browser & Authentication Tokens
  - part: 'contents'
    regex: 'xox[pboa]-[0-9]{12}-[0-9]{12}-[0-9]{12}-[a-z0-9]{32}'
    name: 'Slack Token'
    priority: 3
    color: '#4A154B'
  - part: 'contents'
    regex: 'https://hooks\.slack\.com/services/T[a-zA-Z0-9_]{8}/B[a-zA-Z0-9_]{8}/[a-zA-Z0-9_]{24}'
    name: 'Slack Webhook'
    priority: 3
    color: '#4A154B'
  - part: 'contents'
    regex: '[MN][A-Za-z\d]{23}\.[\w-]{6}\.[\w-]{27}'
    name: 'Discord User/Bot Token'
    verifier: 'discord'
    priority: 3
    color: '#5865F2'
  - part: 'contents'
    regex: 'EAACEdEose0cBA[0-9A-Za-z]{20,}'
    name: 'Facebook Access Token'
    priority: 3
    color: '#1877F2'
  - part: 'contents'
    regex: '[0-9]{8,12}:[A-Za-z0-9_-]{35,50}'
    name: 'Telegram Bot Token'
    verifier: 'telegram'
    priority: 3
    color: '#26A5E4'
  - part: 'contents'
    regex: 'ghp_[A-Za-z0-9]{36}'
    name: 'GitHub Personal Access Token'
    priority: 3
    color: '#2DA44E'
  - part: 'contents'
    regex: 'github_pat_[0-9a-zA-Z_]{22}[0-9a-zA-Z_]{64}'
    name: 'GitHub Fine-Grained PAT'
    priority: 3
    color: '#2DA44E'
  - part: 'contents'
    regex: 'glpat-[0-9a-zA-Z_-]{20}'
    name: 'GitLab Personal Access Token'
    priority: 3
    color: '#FC6D26'
  - part: 'contents'
    regex: 'gho_[0-9a-zA-Z]{36}'
    name: 'GitHub OAuth Token'
    priority: 3
    color: '#2DA44E'
  - part: 'contents'
    regex: 'ghu_[0-9a-zA-Z]{36}'
    name: 'GitHub User-to-Server Token'
    priority: 3
    color: '#2DA44E'
  - part: 'contents'
    regex: 'ghs_[0-9a-zA-Z]{36}'
    name: 'GitHub Server-to-Server Token'
    priority: 3
    color: '#2DA44E'
  - part: 'contents'
    regex: 'ghr_[0-9a-zA-Z]{36}'
    name: 'GitHub Refresh Token'
    priority: 3
    color: '#2DA44E'
  - part: 'contents'
    regex: 'twitter_[A-Za-z0-9]{40}'
    name: 'Twitter API Key'
    priority: 3
    color: '#d53d46'
  - part: 'contents'
    regex: 'reddit_[A-Za-z0-9]{40}'
    name: 'Reddit API Token'
    priority: 3
    color: '#d53d46'
  - part: 'contents'
    regex: 'twitch_[A-Za-z0-9]{40}'
    name: 'Twitch API Token'
    priority: 3
    color: '#d53d46'
  - part: 'contents'
    regex: 'youtube_[A-Za-z0-9]{40}'
    name: 'YouTube API Key'
    priority: 3
    color: '#d53d46'
  - part: 'contents'
    regex: 'linkedin_[A-Za-z0-9]{40}'
    name: 'LinkedIn API Token'
    priority: 3
    color: '#d53d46'
  - part: 'contents'
    regex: 'instagram_[A-Za-z0-9]{40}'
    name: 'Instagram API Token'
    priority: 3
    color: '#d53d46'
  - part: 'contents'
    regex: 'stripe_[a-z]{2,5}_[a-zA-Z0-9]{24}'
    name: 'Stripe API Key'
    priority: 3
    color: '#635BFF'
  - part: 'contents'
    regex: 'pk_[a-z]{4,5}_[a-zA-Z0-9]{24}'
    name: 'Stripe Public Key'
    priority: 3
    color: '#635BFF'
  - part: 'contents'
    regex: 'sk_[a-z]{4,5}_[a-zA-Z0-9]{24}'
    name: 'Stripe Secret Key'
    priority: 3
    color: '#635BFF'
  - part: 'contents'
    regex: 'paypal_[A-Za-z0-9]{40}'
    name: 'PayPal API Token'
    priority: 3
    color: '#d53d46'
  - part: 'contents'
    regex: 'square_[A-Za-z0-9]{40}'
    name: 'Square API Token'
    priority: 3
    color: '#d53d46'
  - part: 'contents'
    regex: 'shopify_[A-Za-z0-9]{40}'
    name: 'Shopify API Token'
    priority: 3
    color: '#d53d46'
  - part: 'contents'
    regex: 'auth0_[A-Za-z0-9]{40}'
    name: 'Auth0 API Token'
    priority: 3
    color: '#d53d46'
  - part: 'contents'
    regex: 'firebase_[A-Za-z0-9]{40}'
    name: 'Firebase API Key'
    priority: 3
    color: '#d53d46'
  - part: 'contents'
    regex: 'supabase_[A-Za-z0-9]{40}'
    name: 'Supabase API Key'
    priority: 3
    color: '#d53d46'
  - part: 'contents'
    regex: 'bearer_[A-Za-z0-9]{40}'
    name: 'Bearer Token'
    priority: 3
    color: '#000000'

  # Cloud & Infrastructure
  - part: 'contents'
    regex: 'AKIA[0-9A-Z]{16}'
    name: 'AWS Access Key ID'
    priority: 3
    color: '#FF9900'
  - part: 'contents'
    regex: 'aws_secret_access_key\s*=\s*[A-Za-z0-9/+=]{40}'
    name: 'AWS Secret Key in Config'
    priority: 3
    color: '#FF9900'
#  - part: 'contents'
#    regex: 'mongodb(\+srv)?:\/\/[a-zA-Z0-9._%+-]+:[a-zA-Z0-9._%+-]+@[a-zA-Z0-9.-]+'
