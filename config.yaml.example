# =============================================================================
#  shhgit configuration
# =============================================================================
#  Sections:
#    credentials  - GitHub tokens, webhook, AI review provider
#    runtime      - performance, scanning, cleanup, logging
#    filters      - blacklisted strings / extensions / paths / entropy
#    signatures   - detection rules, grouped by subject area
#
#  Signature syntax (README "Signatures"):
#    part:      extension | filename | path | contents   (what to match against)
#    match:     exact string            (simple signature; part != contents)
#    regex:     RE2 regular expression  (pattern signature)
#    not_regex: optional RE2 guard; a hit discards the candidate match
#    name:      human readable finding name
#    priority:  3 critical, 2 high, 1 low
#    color:     hex colour used by the log presets
#
#  IMPORTANT: regexes are written in SINGLE quotes on purpose. A YAML
#  double-quoted scalar turns \b into a backspace character, which silently
#  breaks word boundaries; single quotes pass the backslash through untouched.
# =============================================================================

# -----------------------------------------------------------------------------
#  Credentials
# -----------------------------------------------------------------------------

# At least one token is required unless you scan with --local.
github_access_tokens:
  - 'github_pat_YOUR_FINE_GRAINED_PAT_HERE'
  - 'ghp_YOUR_CLASSIC_PAT_HERE'

# Optional: AI tokens validated by --test-tokens.
ai_tokens:
  - 'sk-ant-api03-YOUR_ANTHROPIC_KEY'
  - 'sk-YOUR_OPENAI_KEY'

# One webhook endpoint receives every finding. Works with Discord, Slack,
# Mattermost, Telegram and custom JSON endpoints.
webhook: '$SHHGIT_DISCORD_WEBHOOK'
webhook_discord_user_id: ''  # Optional: Discord user ID to ping for critical findings (AI keys, DB strings)
webhook_payload: |
  {
    "text": "%s"
  }

webhook_queue:
  queue_size: 1000
  # Minimum gap between two sends to the same webhook. Discord webhooks are
  # capped at 5 requests / 2 s, so 500 ms (4 per 2 s) is the safe floor; Discord
  # URLs are held to that even if a smaller value is set here.
  rate_limit_ms: 500
  dedupe_window_sec: 60
  # Coalesce up to this many Discord findings into one message (Discord allows
  # ten embeds per message). Ignored for non-Discord endpoints. 1 disables it.
  batch_size: 10

# -----------------------------------------------------------------------------
#  Runtime
# -----------------------------------------------------------------------------

# minimal | fancy | ultra fancy | even more fancy | neon
logFormat: "fancy"

performance:
  # Threads for cloning/scanning repositories. 8 keeps a laptop responsive;
  # raise it deliberately if you have cores to spare.
  max_repository_threads: 8
  max_gist_threads: 5
  max_comment_threads: 4
  # Events pages fetched per poll cycle (one page = 100 events). The loop stops
  # early on an unchanged (304) or already-seen page, so this is a ceiling, not a
  # target. Keep it small: 50 pages every 5s is ~36k requests/hour against a
  # 5k/hour budget.
  api_pages_per_cycle: 3
  api_per_page: 100
  api_sleep_seconds: 5
  worker_pool_size: 8
  queue_buffer_size: 5000

scanning:
  # Repositories with more files than this are skipped entirely.
  max_file_count: 5000
  # Files larger than this are not scanned: 10 MB of text is minutes of regex.
  max_file_size_mb: 2
  max_repo_size_mb: 1000
  clone_depth: 1
  clone_timeout_seconds: 60
  scan_timeout_seconds: 120
  # Byte budget per repository (0 = no limit). Predictable where a wall-clock
  # timeout is not.
  max_scan_mb: 0
  # Clone and scan a repository at most once per run, not once per push event.
  rescan_repositories: false
  skip_forks: false
  skip_archived: false

cleanup:
  max_disk_usage_mb: 2048
  cleanup_threshold_mb: 1024
  cleanup_interval_secs: 120

ai_review:
  provider: deepseek                # deepseek | openai | custom | ollama
  api_key: ''                       # or DEEPSEEK_API_KEY / SHHGIT_AI_API_KEY
  base_url: ''
  model: deepseek-chat              # deepseek-chat | deepseek-reasoner
  review_dir: ai_review

match_log_dir: logs/matches
match_log_enabled: true

# -----------------------------------------------------------------------------
#  Filters
# -----------------------------------------------------------------------------
# blacklisted_strings is applied with a case-insensitive SUBSTRING test against
# every candidate match, so entries must be complete placeholder values - never
# bare words. Listing "test", "secret" or "user" here would suppress every
# finding whose value merely contains those letters.
blacklisted_strings:
  # Common placeholder/example values
  - AKIAIOSFODNN7EXAMPLE
  - AKIAAABAAAAAAAAAAAAA
  - AIDAQEBAAAAAAAAAAAAA
  - ASIA4W24O3EONQWOERZ5
  - ABCDEFGHIJKLMNOPQRSTUVWXYZabcdef1234
  - AGBBOTSEN7CEF5CNOFTS
  - XXXXXXXX-enter_your_key_here-XXXXXXXX
  - YOUR_API_KEY_HERE
  - YOUR_SECRET_KEY_HERE
  - REPLACE_WITH_YOUR_KEY
  - insert_your_key_here
  - your-api-key-here
  - 'username:password'
  - 'user:pass'
  - 'admin:admin'
  - 'root:root'
  - 'test:test'
  - sshpass -p $SSH_PASS
  # Common test/fake tokens
  - ghp_xoxb_placeholder
  - ghp_placeholder_token_1234567890
  - sk-test-1234567890abcdefghijklmnop
  - sk-fake-1234567890abcdefghijklmnopqrstuvwxyz
  - eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIyfQ.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c
  - PLACEHOLDER
  - FAKE
  - DUMMY
  - MOCK
  - SAMPLE
  - EXAMPLE
  - TODO
  - CHANGEME
  - CHANGE_ME
  - REPLACE_ME
  - FILL_IN_YOUR_KEY
  # Cloud provider test credentials
  - AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
  - aws_access_key_id = AKIAIOSFODNN7EXAMPLE
  # Database test connections
  - postgresql://postgres:password@localhost
  - mysql://root:root@localhost
  - mongodb://localhost:27017
  # Generic fake secrets
  - 'api_key: test_key_12345'
  - 'secret: fake_secret_xyz'
  - 'token: abcd1234efgh5678'
  - 'password: password123'
  - 'password: 123456'
  - 'password: admin'
  # Common placeholder patterns in code
  - const API_KEY = 'YOUR_KEY'
  - const SECRET = 'PLACEHOLDER'
  - API_KEY = 'TODO'
  - SECRET_KEY = 'xxx'
  - private_key = 'fake'
  - public_key = 'placeholder'
  # Ethereum test addresses
  - '0x000000000000000000000000000000000000dead'
  - '0x0000000000000000000000000000000000000000'
  - '0xDeadDeAddeAddEAddeadDEaDDEAdDeaDDeAD0000'
  # --- Additional placeholder / false-positive markers -------------------------
  # Case-insensitive substring match: a finding containing any of these is
  # dropped. Kept specific so a genuine key is never swallowed.
  - '<your'
  - '[your'
  - '{your'
  - 'your_'
  - 'your-'
  - 'yourkey'
  - 'your-key'
  - 'xxx'
  - 'xxxx'
  - 'notareal'
  - 'not_a_real'
  - 'not-real'
  - 'redacted'
  - 'placeholder'
  - 'changeme'
  - 'change-me'
  - 'replace_me'
  - 'replaceme'
  - 'fill_me'
  - 'dummy'
  - 'foobar'
  - 'sample'
  - 'testkey'
  - 'test_key'
  - 'test-secret'
  - 'test_secret'
  - 'fakekey'
  - 'fake_key'
  - 'fake-secret'
  - 'mysecret'
  - 'my_secret'
  - 'my-key'
  - 'my_key'
  - 'secret123'
  - 'password123'
  - 'abcdef123456'
  - 'wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY'
  - 'minioadmin'
  - 'postgres:postgres'
  - 'guest:guest'
  - 'process.env'
  - 'os.getenv'
  - 'System.getenv'
  - 'getenv('
  - '${'
  - '<%='

blacklisted_extensions:
  # Images
  - .exe
  - .jpg
  - .jpeg
  - .png
  - .gif
  - .bmp
  - .ico
  - .svg
  - .webp
  - .tiff
  - .tif
  # Archives
  - .zip
  - .tar
  - .tar.gz
  - .tgz
  - .rar
  - .7z
  - .bz2
  - .xz
  # Documents
  - .pdf
  - .doc
  - .docx
  - .xls
  - .xlsx
  - .ppt
  - .pptx
  - .odt
  - .ods
  - .odp
  # Media
  - .mp3
  - .mp4
  - .avi
  - .mov
  - .wmv
  - .flv
  - .mkv
  - .wav
  - .ogg
  - .flac
  # Other non-code
  - .class
  - .pyc
  - .o
  - .so
  - .dll
  - .dylib
  - .bin
  - .dat
  # Additional binaries and generated files
  - .map
  - .lock
  - .sum
  - .DS_Store
  - .woff
  - .woff2
  - .ttf
  - .eot
  - .jar
  - .war
  - .pyo
  - .wasm
  - .db
  - .sqlite3

blacklisted_paths:
  # Node.js
  - node_modules{sep}
  # PHP
  - vendor{sep}
  - vendor{sep}autoload.php
  # Python
  - __pycache__{sep}
  - .pytest_cache{sep}
  - .venv{sep}
  - venv{sep}
  - .eggs{sep}
  - '*.egg-info{sep}'
  # Go
  - .git{sep}
  # Java
  - target{sep}
  - build{sep}
  - .gradle{sep}
  # Ruby
  - .bundle{sep}
  - vendor{sep}bundle{sep}
  - .ruby-version
  # Rust
  - Cargo.lock
  # .NET
  - bin{sep}
  - obj{sep}
  - packages{sep}
  # IDE / Editor
  - .idea{sep}
  - .vscode{sep}
  - .vs{sep}
  - .eclipse{sep}
  - .settings{sep}
  # Build outputs
  - dist{sep}
  - out{sep}
  - release{sep}
  - debug{sep}
  # Dependencies cache
  - .npm{sep}
  - .yarn{sep}
  - .cache{sep}
  - .parcel-cache{sep}
  - .next{sep}
  - .nuxt{sep}
  - .svelte-kit{sep}
  # Docker / Containers
  - .docker{sep}
  - docker-compose.yml
  - Dockerfile
  # CI/CD
  - .github{sep}workflows{sep}
  - .gitlab-ci.yml
  - .circleci{sep}
  - .travis.yml
  # Documentation
  - docs{sep}
  - doc{sep}
  - .docs{sep}
  # Test files
  - test{sep}
  - tests{sep}
  - __tests__{sep}
  - spec{sep}
  - .test{sep}
  - .spec{sep}
  # Config backups
  - '*.bak'
  - '*.backup'
  - '*.old'
  - '*.orig'

blacklisted_entropy_extensions:
  # Keys / Certificates
  - .pem
  - .key
  - .pub
  - .crt
  - .cer
  - .p12
  - .pfx
  - .jks
  - .keystore
  - id_rsa
  - id_rsa.pub
  - id_ed25519
  - id_ed25519.pub
  - id_dsa
  - id_ecdsa
  - .asc
  # VPN configs
  - .ovpn
  - .vpn
  # Database files
  - .sqlite
  - .sqlite3
  - .db
  - .mdb
  - .accdb
  # Logs
  - .log
  - .logs
  - .trace
  # Config files
  - .env
  - .env.local
  - .env.example
  - .env.sample
  - .env.dev
  - .env.test
  - .env.prod
  - .env.production
  - .env.development
  # Backup files
  - .bak
  - .backup
  - .old
  - .swp
  - .swo
  # Misc
  - .conf
  - .config
  - .ini
  - .toml

signatures:
  # ================================================================
  # CREDENTIALS / SENSITIVE FILES
  # ================================================================
  - part: contents
    regex: (admin_token|admintoken|admin-token)\s*[:=]\s*["\x27]([^\"\x27]{20,})["\x27]
    not_regex: \b(function|class|const|let|var|import|export|return|if|for|while)\b
    name: Admin Token in Quotes
    priority: 2
    color: '#ff3b5c'
  - part: contents
    regex: (app_secret|appsecret|app-secret)\s*[:=]\s*["\x27]([^\"\x27]{20,})["\x27]
    not_regex: \b(function|class|const|let|var|import|export|return|if|for|while)\b
    name: App Secret in Quotes
    priority: 2
    color: '#ff4f6d'
  - part: contents
    regex: (?i)(private_key|privatekey|private-key)\s*[:=]\s*[A-Za-z0-9+/]{86,88}={0,2}
    name: Base64 Encoded Private Key
    priority: 3
    color: '#e83d56'
  - part: contents
    regex: bearer_[A-Za-z0-9]{40}
    name: Bearer Token
    priority: 3
    color: '#ff5c7a'
  - part: contents
    regex: (database_url|db_url|db_connection|connection_string|conn_string)\s*[:=]\s*["\x27]([^\"\x27]{20,})["\x27]
    name: Database Connection String in Quotes
    priority: 3
    color: '#ff3b5c'
  - part: contents
    regex: '(postgres(ql)?|cockroachdb|mysql|mariadb|mongodb(\+srv)?|rediss?|amqps?|mssql|sqlserver|clickhouse|neo4j)://[^\s:@/]*:[^\s:@/]+@'
    name: Database Connection String with Credentials
    priority: 3
    color: '#ff3b5c'
  - part: contents
    regex: 'jdbc:[a-z0-9]+://[^\s:@/]*:[^\s:@/]+@'
    name: JDBC Connection String with Credentials
    priority: 3
    color: '#ff3b5c'
  - part: contents
    regex: '(?i)(Data Source|Server)=tcp:[^;]+;[^;]*(Password|Pwd)='
    name: ADO.NET Connection String
    priority: 3
    color: '#ff3b5c'
  - part: contents
    regex: (db_password|dbpassword|db-password|database_password|databasepassword|database-password)\s*[:=]\s*["\x27]([^\"\x27]{8,})["\x27]
    name: Database Password in Quotes
    priority: 3
    color: '#ff4f6d'
  - part: contents
    regex: (encryption_key|encryptionkey|encryption-key|encrypt_key|encryptkey|encrypt-key)\s*[:=]\s*["\x27]([^\"\x27]{20,})["\x27]
    name: Encryption Key in Quotes
    priority: 3
    color: '#e83d56'
  - part: filename
    regex: ^\.?env\.(production|development|local)
    name: Environment file variant
    priority: 3
    color: '#ff5c7a'
  - part: contents
    regex: ya29\.[0-9A-Za-z_-]{20,40}
    name: Google OAuth Token
    priority: 3
    color: '#ff3b5c'
  - part: contents
    regex: (jwt|bearer|authorization)\s*[:=]\s*["\x27]([A-Za-z0-9_-]{20,})["\x27]
    not_regex: \b(function|class|const|let|var|import|export|return)\b
    name: JWT/Bearer Token in Quotes
    priority: 2
    color: '#ff4f6d'
  - part: contents
    regex: 'eyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}'
    name: JSON Web Token
    priority: 2
    color: '#ff4f6d'
  - part: contents
    regex: (master_key|masterkey|master-key)\s*[:=]\s*["\x27]([^\"\x27]{20,})["\x27]
    not_regex: \b(function|class|const|let|var|import|export|return)\b
    name: Master Key in Quotes
    priority: 2
    color: '#e83d56'
  - part: contents
    regex: (client_secret|clientsecret|client-secret)\s*[:=]\s*["\x27]([^\"\x27]{20,})["\x27]
    not_regex: \b(function|class|const|let|var|import|export|return)\b
    name: OAuth Client Secret in Quotes
    priority: 2
    color: '#ff5c7a'
  - part: contents
    regex: (oauth_token|oauthtoken|oauth-token)\s*[:=]\s*["\x27]([^\"\x27]{20,})["\x27]
    not_regex: \b(function|class|const|let|var|import|export|return)\b
    name: OAuth Token in Quotes
    priority: 2
    color: '#ff3b5c'
  - part: contents
    regex: (private_key|privatekey|private-key|secret_key|secretkey|secret-key)\s*[:=]\s*["\x27]([^\"\x27]{20,})["\x27]
    not_regex: \b(function|class|const|let|var|import|export|return)\b
    name: Private Key in Quotes
    priority: 2
    color: '#ff4f6d'
  - part: contents
    regex: '-----BEGIN [A-Z0-9 ]*PRIVATE KEY[A-Z ]*-----'
    name: PEM Private Key Block
    priority: 3
    color: '#ff3b5c'
  - part: contents
    regex: (root_password|rootpassword|root-password)\s*[:=]\s*["\x27]([^\"\x27]{8,})["\x27]
    not_regex: \b(function|class|const|let|var|import|export|return)\b
    name: Root Password in Quotes
    priority: 2
    color: '#e83d56'
  - part: contents
    regex: (signing_key|signingkey|signing-key|sign_key|signkey|sign-key)\s*[:=]\s*["\x27]([^\"\x27]{20,})["\x27]
    not_regex: \b(function|class|const|let|var|import|export|return)\b
    name: Signing Key in Quotes
    priority: 2
    color: '#ff5c7a'
  - part: filename
    regex: (dump|logs)\.sql
    name: SQL database dump/logs
    priority: 3
    color: '#ff3b5c'
  - part: contents
    regex: (ssh_key|sshkey|ssh-key|ssh_password|sshpassword|ssh-password)\s*[:=]\s*["\x27]([^\"\x27]{10,})["\x27]
    name: SSH Credentials in Quotes
    priority: 3
    color: '#ff4f6d'
  - part: contents
    regex: (access_token|accesstoken|access-token|refresh_token|refreshtoken|refresh-token)\s*[:=]\s*["\x27]([^\"\x27]{20,})["\x27]
    not_regex: \b(function|class|const|let|var|import|export|return)\b
    name: Token in Quotes
    priority: 2
    color: '#e83d56'
  - part: contents
    regex: (username|user|login)\s*[:=]\s*["\x27]([^\"\x27]{3,})["\x27].*?(password|passwd|pwd)\s*[:=]\s*["\x27]([^\"\x27]{3,})["\x27]
    name: Username and Password Pair
    priority: 3
    color: '#ff5c7a'
  - part: contents
    regex: (certificate|cert|ssl_cert|sslcert|ssl-cert)\s*[:=]\s*["\x27]-----BEGIN[^\"\x27]{50,}["\x27]
    name: Certificate in Quotes
    priority: 2
    color: '#ff3b5c'
  - part: extension
    match: .pem
    name: Cryptographic private key
    priority: 2
    color: '#ff4f6d'
  - part: contents
    regex: (ftp_password|ftppassword|ftp-password|ftp_user|ftpuser|ftp-user)\s*[:=]\s*["\x27]([^\"\x27]{5,})["\x27]
    not_regex: \b(function|class|const|let|var|import|export|return)\b
    name: FTP Credentials in Quotes
    priority: 1
    color: '#e83d56'
  - part: filename
    match: credentials.xml
    name: Jenkins credentials file
    priority: 2
    color: '#ff5c7a'
  - part: contents
    regex: (client_id|clientid|client-id)\s*[:=]\s*["\x27]([^\"\x27]{20,})["\x27]
    not_regex: \b(function|class|const|let|var|import|export|return)\b
    name: OAuth Client ID in Quotes
    priority: 1
    color: '#ff3b5c'
  - part: filename
    regex: ^\.?(netrc|git-credentials|npmrc)
    name: Sensitive configuration files
    priority: 2
    color: '#ff4f6d'
  - part: contents
    regex: (session_id|sessionid|session-id|session_token|sessiontoken|session-token)\s*[:=]\s*["\x27]([^\"\x27]{20,})["\x27]
    not_regex: \b(function|class|const|let|var|import|export|return)\b
    name: Session Token in Quotes
    priority: 1
    color: '#e83d56'
  - part: contents
    regex: (smtp_password|smtppassword|smtp-password|smtp_user|smtpuser|smtp-user)\s*[:=]\s*["\x27]([^\"\x27]{5,})["\x27]
    not_regex: \b(function|class|const|let|var|import|export|return)\b
    name: SMTP Credentials in Quotes
    priority: 1
    color: '#ff5c7a'
  - part: contents
    regex: (webhook|webhook_url|hook_url)\s*[:=]\s*["\x27]https?://[^\"\x27]{20,}["\x27]
    not_regex: \b(function|class|const|let|var|import|export|return)\b
    name: Webhook URL in Quotes
    priority: 1
    color: '#ff3b5c'
  - part: filename
    regex: ^\.?bash_history
    name: Bash history file
    priority: 1
    color: '#ff4f6d'
  - part: contents
    regex: sk-ant-api03-[a-zA-Z0-9_-]{95}
    name: Anthropic Claude API Key
    verifier: claude
    priority: 3
    color: '#b83dd5'
  - part: contents
    regex: (?i)(anthropic|claude)[\s_-]*(api[\s_-]*key|token)\s*[:=]\s*["\x27]?(sk-ant-[A-Za-z0-9_-]{95,})["\x27]?
    name: Anthropic Claude API Key in Assignment
    priority: 3
    color: '#d53dbd'
  - part: contents
    regex: gsk_[A-Za-z0-9]{50,}
    name: Groq API Key (gsk_ prefix)
    priority: 3
    color: '#c93dd5'
  - part: contents
    regex: hf_[A-Za-z0-9]{34}
    name: Hugging Face API Key
    priority: 3
    color: '#e33dd0'
  - part: contents
    regex: (?i)(huggingface|hf)[\s_-]*(api[\s_-]*key|token)\s*[:=]\s*["\x27]?(hf_[A-Za-z0-9]{34})["\x27]?
    name: Hugging Face API Key in Assignment
    priority: 3
    color: '#b83dd5'
  - part: contents
    regex: (?i)(moonshot|kimi)[\s_-]*(api[\s_-]*key|token)\s*[:=]\s*["\x27]?(sk-[A-Za-z0-9]{20,})["\x27]?
    name: Moonshot / Kimi API Key in Assignment
    priority: 3
    color: '#c93dd5'
  - part: contents
    regex: sk-[a-zA-Z0-9]{48}
    name: OpenAI API Key
    verifier: openai
    priority: 3
    color: '#c93dd5'
  - part: contents
    regex: (?i)(openai|gpt)[\s_-]*(api[\s_-]*key|token)\s*[:=]\s*["\x27]?(sk-[A-Za-z0-9]{48})["\x27]?
    name: OpenAI API Key in Assignment
    priority: 3
    color: '#e33dd0'
  - part: contents
    regex: sk-proj-[A-Za-z0-9_-]{48}
    name: OpenAI Project API Key
    priority: 3
    color: '#b83dd5'
  - part: contents
    regex: sk-or-v1-[A-Za-z0-9]{40,}
    name: OpenRouter API Key
    priority: 3
    color: '#d53dbd'
  - part: contents
    regex: pplx-[A-Za-z0-9]{40,}
    name: Perplexity API Key (pplx- prefix)
    priority: 3
    color: '#c93dd5'
  - part: contents
    regex: sk-[a-f0-9]{32}
    name: Qwen / Deepseek API Key (32-char hex)
    priority: 3
    color: '#e33dd0'
  - part: contents
