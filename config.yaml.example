    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\bforgejo[\\w.-]{0,20}\\s*[:=]\\s*[\"']?[a-f0-9]{40}\\b"
    name: 'Forgejo API Token'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\bcodeberg[\\w.-]{0,20}\\s*[:=]\\s*[\"']?[a-f0-9]{40}\\b"
    name: 'Codeberg API Token'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
