# ============================================================================
# shhgit example configuration
# ============================================================================
# Copy this file to config.yaml and fill in your own values:
#
#     cp config.yaml.example config.yaml
#
# config.yaml is gitignored — never commit real tokens.
# Every key below is recognized by core/config.go. Values shown are safe
# placeholders; the file is not usable until you replace them. Keys the binary
# parses but does not yet act on are called out explicitly in comments.
# ============================================================================

# Performance optimization settings — every key is honored by the scanner
# (core/config.go). Absent keys keep the compiled-in defaults. Values here
# are conservative examples; crank them up for maximum throughput.
performance:
  max_repository_threads: 3
  max_gist_threads: 3
  max_comment_threads: 3
  api_pages_per_cycle: 5
  api_per_page: 100
  api_sleep_seconds: 15
  worker_pool_size: 3
  queue_buffer_size: 2
  max_file_count: 10000            # files processed per repository before skipping

logFormat: "fancy"                 # minimal | fancy | ultra fancy | even more fancy | neon
                                   # minimal prints exactly one line per finding (for CI); the rest add styling.

# ---------------------------------------------------------------------------
# AI security review
# ---------------------------------------------------------------------------
# A "Review" action on any match sends that finding (secret, file and file
# content) to the configured LLM, which returns an impact, exploitability and
# remediation assessment, and then answers follow-up questions about it.
#
# provider is one of: deepseek | openai | custom | ollama
#
# These settings only SEED the AI configuration the first time shhgit runs.
# After that the dashboard's Settings tab owns them, persisted to
# ai_review/settings.json. Environment variables act as per-field fallbacks for
# fields left blank, so a value saved in the UI always wins:
#   SHHGIT_AI_PROVIDER, SHHGIT_AI_API_KEY, SHHGIT_AI_BASE_URL, SHHGIT_AI_MODEL
#   SHHGIT_AI_<PROVIDER>_{API_KEY,BASE_URL,MODEL}
#   DEEPSEEK_API_KEY, OPENAI_API_KEY (vendor aliases)
#
# Prefer the environment variables for the key so no secret lives in this file.
#
# PRIVACY: a cloud provider receives the detected credential and the surrounding
# file content in plain text. Use provider: ollama to keep everything local.
ai_review:
  provider: deepseek              # deepseek | openai | custom | ollama
  api_key: ''                     # or DEEPSEEK_API_KEY / OPENAI_API_KEY / SHHGIT_AI_API_KEY
  base_url: ''                    # blank = the provider's default endpoint
  model: ''                       # blank = the provider's default model
  review_dir: ai_review           # where reviews and AI settings are stored (gitignored)
  # system_prompt: ''             # optional override; a security-review prompt is built in
  # Legacy single-backend keys (backend, deepseek_api_key, deepseek_model,
  # ollama_url, ollama_model) are still read when the keys above are unset.

ai_tokens:
  # OpenAI and related
  - 'sk-[your-openai-token-here]'
  - 'sk-proj-[your-openai-project-token-here]'
  
  # Anthropic Claude
  - 'sk-ant-api03-[your-claude-token-here]'
  - 'claude_[your-claude-token-alternative]'
  - 'anthropic_[your-anthropic-token]'
  
  # Google AI
