  # ================================================================
  # CRM / HELP DESK / MARKETING
  # ================================================================
  # Zendesk: specific token format (alphanumeric, 40+ chars)
  - part: contents
    regex: (?i)zendesk[_-]?api[_-]?key\s*[:=]\s*["\x27]?([A-Za-z0-9]{40})["\x27]?
    name: Zendesk API Key
    priority: 3
    color: '#FFA500'
  # Intercom: UUID-like format
  - part: contents
    regex: (?i)intercom[_-]?(access[_-]?)?token\s*[:=]\s*["\x27]?([a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12})["\x27]?
    name: Intercom Access Token
    priority: 3
    color: '#1F8CED'
  # Freshdesk: has specific prefix
  - part: contents
    regex: (?i)freshdesk[_-]?api[_-]?key\s*[:=]\s*["\x27]?([A-Za-z0-9]{20})["\x27]?
    name: Freshdesk API Key
    priority: 3
    color: '#FF6B35'
  # Pipedrive: exact 40 hex chars
  - part: contents
    regex: (?i)pipedrive[_-]?api[_-]?token\s*[:=]\s*["\x27]?([a-f0-9]{40})["\x27]?
    name: Pipedrive API Token
    priority: 3
    color: '#00D654'
  # HubSpot: UUID-like format
  - part: contents
    regex: (?i)hubspot[_-]?api[_-]?key\s*[:=]\s*["\x27]?([a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12})["\x27]?
    name: HubSpot API Key
    priority: 3
    color: '#FF7A59'
  # Attio: specific prefix format
  - part: contents
    regex: (?i)attio[_-]?api[_-]?key\s*[:=]\s*["\x27]?(attk_[a-zA-Z0-9_-]{32})["\x27]?
    name: Attio API Key
    priority: 3
    color: '#5B5FEF'
  # SparkPost: specific prefix
  - part: contents
    regex: (?i)sparkpost[_-]?(api[_-]?)?key\s*[:=]\s*["\x27]?([a-f0-9]{32})["\x27]?
    name: SparkPost API Key
    priority: 3
    color: '#8200C9'
  # Resend: re_ prefix (very specific)
  - part: contents
    regex: (?i)resend[_-]?api[_-]?key\s*[:=]\s*["\x27]?(re_[A-Za-z0-9_-]{24})["\x27]?
    name: Resend API Key
    priority: 3
    color: '#000000'
  # Postmark: specific 32 hex chars
  - part: contents
    regex: (?i)postmark[_-]?(api[_-]?)?token\s*[:=]\s*["\x27]?([a-f0-9]{32})["\x27]?
    name: Postmark API Token
    priority: 3
    color: '#F5D800'
  # Loops: specific 32 hex chars
  - part: contents
    regex: (?i)loops[_-]?api[_-]?key\s*[:=]\s*["\x27]?([a-f0-9]{32})["\x27]?
    name: Loops API Key
    priority: 3
    color: '#6366F1'
  # Brevo: specific 32 hex chars
  - part: contents
    regex: (?i)brevo[_-]?api[_-]?key\s*[:=]\s*["\x27]?([a-f0-9]{32})["\x27]?
    name: Brevo (Sendinblue) API Key
    priority: 3
    color: '#0092FF'

  # ================================================================
  # ADDITIONAL AI / ML PROVIDERS
  # ================================================================
  # Stability AI: sk_ prefix with specific format
  - part: contents
    regex: (?i)stability[_-]?ai[_-]?api[_-]?key\s*[:=]\s*["\x27]?(sk-[a-zA-Z0-9_-]{32})["\x27]?
    name: Stability AI API Key
    priority: 3
    color: '#0F172A'
  # Replicate: r8_ prefix (already exists, keeping for specificity)
  - part: contents
    regex: (?i)replicate[_-]?api[_-]?token\s*[:=]\s*["\x27]?(r8_[A-Za-z0-9]{20,})["\x27]?
    name: Replicate API Token
    priority: 3
    color: '#6B7280'
  # OpenRouter: sk-or-v1 or openrouter_ prefix
  - part: contents
    regex: (?i)openrouter[_-]?api[_-]?key\s*[:=]\s*["\x27]?(sk-or-v1-[A-Za-z0-9]{40,})["\x27]?
    name: OpenRouter API Key in Assignment
    priority: 3
    color: '#8B5CF6'
  # Perplexity: pplx- prefix
  - part: contents
    regex: (?i)perplexity[_-]?api[_-]?key\s*[:=]\s*["\x27]?(pplx-[A-Za-z0-9]{40,})["\x27]?
    name: Perplexity API Key in Assignment
    priority: 3
    color: '#10B981'
  # Cerebras: specific prefix
  - part: contents
    regex: (?i)cerebras[_-]?api[_-]?key\s*[:=]\s*["\x27]?(cbrs_[a-zA-Z0-9_-]{32})["\x27]?
    name: Cerebras API Key
    priority: 3
    color: '#EC4899'
  # NVIDIA NIM: specific format
  - part: contents
    regex: (?i)nvidia[_-]?nim[_-]?api[_-]?key\s*[:=]\s*["\x27]?(nvapi-[a-zA-Z0-9_-]{20,})["\x27]?
    name: NVIDIA NIM API Key
    priority: 3
    color: '#76B900'

  # ================================================================
  # CRYPTO WALLET PRIVATE KEYS & SEEDS (ACTUAL ACCESS)
  # ================================================================
  # BIP39 Seed Phrases (12-24 words) - WORKS FOR MOST BLOCKCHAINS
  - part: contents
    regex: '(?i)(mnemonic|seed_phrase|seedphrase|seed-phrase|recovery_phrase|recoveryphrase|recovery-phrase|bip39|secret_recovery_phrase|wallet_seed|wallet-mnemonic)\s*[:=]\s*["\x27]([a-z\s]{25,})["\x27]'
    name: BIP39 Seed Phrase (Quoted)
    priority: 3
    color: '#ff0000'
  - part: contents
    regex: '(?i)SEED_PHRASE\s*=\s*["\x27]([a-z\s]{25,})["\x27]'
    name: SEED_PHRASE Environment Variable
    priority: 3
    color: '#ff0000'

  - part: contents
    regex: '(?i)(private_key|privatekey|private-key|secret_key|secretkey|secret-key)\s*[:=]\s*0x[a-fA-F0-9]{64}'
    name: Ethereum Private Key (in variable)
    priority: 3
    color: '#ff0000'
  - part: contents
    regex: 0x[a-fA-F0-9]{64}
    name: Ethereum Private Key (Standalone)
    verifier: crypto_balance
    priority: 3
    color: '#ff0000'
  - part: contents
    regex: '(?i)(eth|ethereum|evm|web3|wallet)[_-]?private[_-]?key\s*[:=]\s*["\x27]?0x[a-fA-F0-9]{64}["\x27]?'
    name: Ethereum Private Key
    verifier: crypto_balance
    priority: 3
    color: '#ff0000'

  # Bitcoin Private Keys
  - part: contents
    regex: '(?i)(btc|bitcoin)[_-]?private[_-]?key\s*[:=]\s*["\x27]?[KL][1-9A-HJ-NP-Za-km-z]{50,51}["\x27]?'
    name: Bitcoin Private Key (WIF)
    verifier: crypto_balance
    priority: 3
    color: '#ff0000'
  - part: contents
    regex: '(?i)(xprv|ypub|zprv|tprv)[a-zA-Z0-9]{107,111}'
    name: Bitcoin Extended Private Key (xprv)
    priority: 3
    color: '#ff0000'

  # Solana Private Keys
  - part: contents
    regex: '(?i)(sol|solana)[_-]?private[_-]?key\s*[:=]\s*["\x27]?[A-Za-z0-9+/=]{86,88}["\x27]?'
    name: Solana Private Key (Base64)
    priority: 3
    color: '#ff0000'
  - part: contents
    regex: '(?i)(sol|solana)[_-]?secret[_-]?key\s*[:=]\s*\[[0-9,\s]+\]'
    name: Solana Secret Key (Array)
    priority: 3
    color: '#ff0000'

  # Polygon Private Key
  - part: contents
    regex: '(?i)(polygon|matic)[_-]?private[_-]?key\s*[:=]\s*["\x27]?0x[a-fA-F0-9]{64}["\x27]?'
    name: Polygon Private Key
    verifier: crypto_balance
    priority: 3
    color: '#ff0000'

  # Arbitrum Private Key
  - part: contents
    regex: '(?i)(arbitrum|arb)[_-]?private[_-]?key\s*[:=]\s*["\x27]?0x[a-fA-F0-9]{64}["\x27]?'
    name: Arbitrum Private Key
    verifier: crypto_balance
    priority: 3
    color: '#ff0000'

  # Optimism Private Key
  - part: contents
    regex: '(?i)(optimism|op)[_-]?private[_-]?key\s*[:=]\s*["\x27]?0x[a-fA-F0-9]{64}["\x27]?'
    name: Optimism Private Key
    verifier: crypto_balance
    priority: 3
    color: '#ff0000'

  # Avalanche Private Key
  - part: contents
    regex: '(?i)(avalanche|avax)[_-]?private[_-]?key\s*[:=]\s*["\x27]?0x[a-fA-F0-9]{64}["\x27]?'
    name: Avalanche Private Key
    verifier: crypto_balance
    priority: 3
    color: '#ff0000'

  # BSC/BNB Chain Private Key
  - part: contents
    regex: '(?i)(bsc|binance|bnb)[_-]?private[_-]?key\s*[:=]\s*["\x27]?0x[a-fA-F0-9]{64}["\x27]?'
    name: BSC Private Key
    verifier: crypto_balance
    priority: 3
    color: '#ff0000'

  # Fantom Private Key
  - part: contents
    regex: '(?i)(fantom|ftm)[_-]?private[_-]?key\s*[:=]\s*["\x27]?0x[a-fA-F0-9]{64}["\x27]?'
    name: Fantom Private Key
    priority: 3
    color: '#ff0000'

  # Solana/Phantom Wallet Import (base58)
  - part: contents
    regex: '(?i)(phantom|sollet|slope|ledger|trezor)[_-]?(wallet)?[_-]?(seed|key|secret)\s*[:=]\s*["\x27]?[1-9A-HJ-NP-Za-km-z]{43,44}["\x27]?'
    name: Solana Wallet Seed
    priority: 3
    color: '#ff0000'

  # Keystore/JSON Wallet Files
  - part: contents
    regex: '(?i)(keystore|json)[_-]?(wallet|file)?\s*[:=]\s*["\x27]{.*?"crypto".*}["\x27]'
    name: Keystore JSON Wallet
    priority: 3
    color: '#ff0000'

  # Tron Private Key
  - part: contents
    regex: '(?i)(tron|trx)[_-]?private[_-]?key\s*[:=]\s*["\x27]?[a-fA-F0-9]{64}["\x27]?'
    name: TRON Private Key
    priority: 3
    color: '#ff0000'

  # Cosmos/Atom Private Key (bech32)
  - part: contents
    regex: '(?i)(cosmos|atom)[_-]?private[_-]?key\s*[:=]\s*["\x27]?cosmospriv1[a-z0-9]{38,39}["\x27]?'
    name: Cosmos Private Key
    priority: 3
    color: '#ff0000'

  # Polkadot/Substrate Private Key
  - part: contents
    regex: '(?i)(polkadot|dot|substrate)[_-]?private[_-]?key\s*[:=]\s*["\x27]?[a-fA-F0-9]{64}["\x27]?'
    name: Polkadot Private Key
    priority: 3
    color: '#ff0000'

  # NEAR Private Key
  - part: contents
    regex: '(?i)(near)[_-]?private[_-]?key\s*[:=]\s*["\x27]?ed25519:[a-zA-Z0-9_-]{44}["\x27]?'
    name: NEAR Private Key
    priority: 3
    color: '#ff0000'

  # Aptos Private Key
  - part: contents
    regex: '(?i)(aptos|apt)[_-]?private[_-]?key\s*[:=]\s*["\x27]?0x[a-fA-F0-9]{64}["\x27]?'
    name: Aptos Private Key
    priority: 3
    color: '#ff0000'

  # Sui Private Key
  - part: contents
    regex: '(?i)(sui)[_-]?private[_-]?key\s*[:=]\s*["\x27]?0x[a-fA-F0-9]{64}["\x27]?'
    name: Sui Private Key
    priority: 3
    color: '#ff0000'

  # Algorand Private Key (mnemonic)
  - part: contents
    regex: '(?i)(algorand|algo)[_-]?(private[_-]?)?key\s*[:=]\s*["\x27]?([a-z]+\s+){25}["\x27]?'
    name: Algorand Seed Phrase
    priority: 3
    color: '#ff0000'

  # Tezos Private Key (base58)
  - part: contents
    regex: '(?i)(tezos|xtz)[_-]?private[_-]?key\s*[:=]\s*["\x27]?edsk[a-zA-Z0-9]{48,}["\x27]?'
    name: Tezos Private Key
    priority: 3
    color: '#ff0000'

  # StarkNet Private Key
  - part: contents
    regex: '(?i)(starknet|stark)[_-]?private[_-]?key\s*[:=]\s*["\x27]?0x[a-fA-F0-9]{63,64}["\x27]?'
    name: StarkNet Private Key
    priority: 3
    color: '#ff0000'

  # Monero Private Key (mnemonic)
  - part: contents
    regex: '(?i)(monero|xmr)[_-]?(private[_-]?)?(seed|key|mnemonic)\s*[:=]\s*["\x27]?([a-z]+\s+){25}["\x27]?'
    name: Monero Seed Phrase
    priority: 3
    color: '#ff0000'

  # Zcash Private Key (Sapling)
  - part: contents
    regex: '(?i)(zcash|zec)[_-]?private[_-]?key\s*[:=]\s*["\x27]?zs[a-zA-Z0-9]{78}["\x27]?'
    name: Zcash Private Key
    priority: 3
    color: '#ff0000'

  # Secret Network/Keplr Wallet
  - part: contents
    regex: '(?i)(secret|scrt)[_-]?(wallet)?[_-]?seed\s*[:=]\s*["\x27]?([a-z]+\s+){24}["\x27]?'
    name: Secret Network Seed
    priority: 3
    color: '#ff0000'

  # MetaMask/WalletConnect Vault
  - part: contents
    regex: '(?i)(metamask|walletconnect|vault)[_-]?(data|backup|json)\s*[:=]\s*["\x27]{.*?"iv".*"salt".*}["\x27]'
    name: Crypto Wallet Vault Backup
    priority: 3
    color: '#ff0000'

  # Generic Wallet JSON with private key
  - part: contents
    regex: '(?i)"(private|secret|seed)"\s*:\s*"[a-fA-F0-9]{64}"'
    name: Wallet JSON Private Key
    priority: 3
    color: '#ff0000'
  # ================================================================
  # NON-SECRET IDENTIFIERS
  # ================================================================
  - part: contents
    regex: pk\.eyJ[A-Za-z0-9_-]{80,}
    name: Mapbox Public Access Token
    priority: 2
    color: '#6b7280'
  - part: contents
    regex: (?i)(gemini|palm|bard|makersuite|vertex)[\s_-]*(api[\s_-]*key|token)\s*[:=]\s*["\x27]?(AIza[A-Za-z0-9_-]{35})["\x27]?
    name: Google AI API Key in Assignment
    priority: 3
    color: '#9ca3af'
  - part: contents
    regex: AIza[0-9A-Za-z_-]{35}
    name: Google API Key
    priority: 3
    color: '#9ca3af'
  - part: contents
    regex: GOCSPX-[A-Za-z0-9_-]{28}
    name: Google OAuth Client Secret
    priority: 3
    color: '#9ca3af'
  - part: contents
    regex: ls__[A-Za-z0-9_-]{40,}
    name: LangSmith Legacy API Key
    priority: 3
    color: '#9ca3af'
  - part: contents
    regex: lsv2_sk_[A-Za-z0-9_-]{40,}
    name: LangSmith V2 API Key
    priority: 3
    color: '#9ca3af'
  - part: contents
    regex: sk\.eyJ[A-Za-z0-9_-]{80,}
    name: Mapbox Secret Access Token
    priority: 3
    color: '#9ca3af'
  - part: contents
    regex: pcsk_[A-Za-z0-9_-]{40,}
    name: Pinecone API Key
    priority: 3
    color: '#9ca3af'
  - part: contents
    regex: phx_[A-Za-z0-9]{40,}
    name: PostHog API Key
    priority: 3
    color: '#9ca3af'
  - part: contents
    regex: 'secret_[A-Za-z0-9]{43}|ntn_[0-9]{11}[A-Za-z0-9]{32}'
    name: Notion Integration Token
    priority: 3
    color: '#9ca3af'
  - part: contents
    regex: lin_api_[A-Za-z0-9]{40}
    name: Linear API Key
    priority: 3
    color: '#9ca3af'
  - part: contents
    regex: 'pat[A-Za-z0-9]{14}\.[a-f0-9]{64}'
    name: Airtable Personal Access Token
    priority: 3
    color: '#9ca3af'
  - part: contents
    regex: sbp_[0-9a-f]{40}
    name: Supabase Personal Access Token
    priority: 3
    color: '#9ca3af'
  - part: contents
    regex: 'DefaultEndpointsProtocol=https?;AccountName=[a-z0-9]+;AccountKey=[A-Za-z0-9+/=]{88}'
    name: Azure Storage Connection String
    priority: 3
    color: '#9ca3af'
  - part: contents
    regex: '"type"\s*:\s*"service_account"'
    name: GCP Service Account JSON
    priority: 3
    color: '#9ca3af'
  - part: filename
    match: .env
    name: Environment Configuration File
    priority: 2
    color: '#9ca3af'
  - part: filename
    match: .openclaw
    name: OpenClaw Configuration File
    priority: 2
    color: '#9ca3af'
  - part: path
    regex: \.openclaw
    name: OpenClaw Directory/File
    priority: 2
    color: '#9ca3af'
  - part: filename
    regex: ^\.?dockercfg
    name: Docker configuration file
    priority: 1
    color: '#9ca3af'
