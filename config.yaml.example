  - part: 'contents'
    regex: "(?i)\\b(?:google[_-]?maps|google[_-]?places|geocod(?:e|ing))[\\w.-]{0,20}\\s*[:=]\\s*[\"']?AIza[0-9A-Za-z_-]{35}"
    name: 'Google Maps / Places / Geocoding API Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\b(?:google[_-]?(?:drive|sheets|youtube|ads|translate|vision|speech|natural[_-]?language)|youtube[_-]?(?:data|analytics)|search[_-]?console)[\\w.-]{0,20}\\s*[:=]\\s*[\"']?(?:AIza[0-9A-Za-z_-]{35}|ya29\\.[0-9A-Za-z_-]{20,})"
    name: 'Google Drive / Sheets / YouTube / Ads / Translate / Vision / Speech / NL API Credential'
