    priority: 2
    color: '#f28c28'
  - part: contents
    regex: (?i)(telos|tlos)_address\s*[:=]\s*[a-z1-5]{12}
    name: Telos Wallet Address
    priority: 2
    color: '#a65ad9'
  - part: contents
    regex: (?i)(tezos|xtz)_address\s*[:=]\s*tz[123][a-zA-Z0-9]{33,34}
    name: Tezos Wallet Address
    priority: 2
    color: '#8f67d5'
  - part: contents
    regex: (?i)(theta|tfuel)_address\s*[:=]\s*0x[a-fA-F0-9]{40}
    name: Theta Wallet Address
    priority: 2
    color: '#e09a3d'
  - part: contents
    regex: (?i)(thorchain|rune)_address\s*[:=]\s*thor1[a-z0-9]{38,39}
    name: THORChain Wallet Address
    priority: 2
    color: '#f28c28'
  - part: contents
    regex: (?i)(tron|trx)_address\s*[:=]\s*T[a-zA-Z0-9]{33}
    name: TRON Wallet Address
    priority: 2
    color: '#a65ad9'
  - part: contents
    regex: (?i)(vechain|vet)_address\s*[:=]\s*0x[a-fA-F0-9]{40}
    name: VeChain Wallet Address
    priority: 2
    color: '#8f67d5'
  - part: contents
    regex: (?i)(waves)_address\s*[:=]\s*3[a-zA-Z0-9]{33}
    name: Waves Wallet Address
    priority: 2
    color: '#e09a3d'
  - part: contents
    regex: (?i)(zcash|zec)_address\s*[:=]\s*(t1|z)[a-zA-Z0-9]{33,34}
