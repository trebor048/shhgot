  # Multi-Language Environment Variable Patterns

  - part: 'contents'
    regex: 'process\.env\[["\x27]([\w_]+)["\x27]\]\s*=\s*["\x27]([^\"\x27]{8,})["\x27]'
    name: 'JavaScript process.env Bracket Assignment'
    priority: 2
    color: '#d53d46'
  - part: 'contents'
    regex: 'os\.getenv\([["\x27]([\w_]+)["\x27]\s*,\s*["\x27]([\w\W]{8,})["\x27]'
    name: 'Python os.getenv with Default'
    priority: 2
    color: '#d53d46'
  - part: 'contents'
    regex: 'os\.environ\[["\x27]([\w_]+)["\x27]\]\s*=\s*["\x27]([^\"\x27]{8,})["\x27]'
    name: 'Python os.environ Assignment'
    priority: 2
    color: '#d53d46'
  - part: 'contents'
    regex: 'ENV\[["\x27]([\w_]+)["\x27]\]\s*=\s*["\x27]([^\"\x27]{8,})["\x27]'
    name: 'Ruby ENV Assignment'
    priority: 2
    color: '#d53d46'
  - part: 'contents'
    regex: 'ENV\.fetch\([["\x27]([\w_]+)["\x27]\s*,\s*["\x27]([\w\W]{8,})["\x27]'
    name: 'Ruby ENV.fetch with Default'
    priority: 2
    color: '#d53d46'
  - part: 'contents'
    regex: 'getenv\([["\x27]([\w_]+)["\x27]\)'
    name: 'PHP getenv Call'
    priority: 1
    color: '#d53d46'
  - part: 'contents'
    regex: '@Value\(\"\$\{([\w_]+)\}\"\)'
    name: 'Spring @Value Annotation'
    priority: 1
    color: '#d53d46'
  - part: 'contents'
    regex: '@ConfigurationProperties\(prefix\s*=\s*["\x27]([\w_]+)["\x27]\)'
    name: 'Spring @ConfigurationProperties'
    priority: 1
    color: '#d53d46'

