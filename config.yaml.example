  # ═══════════════════════════════════════════════════════════════════════
  # 2. MAJOR CLOUD PROVIDERS - AWS
  # ═══════════════════════════════════════════════════════════════════════

  - part: 'contents'
    regex: '\b(?:A3T[A-Z0-9]|AKIA|AGPA|AIDA|AROA|AIPA|ANPA|ANVA|ASIA)[A-Z0-9]{16}\b'
    name: 'AWS Access Key ID / IAM Credentials / IAM Role Credentials'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\baws[_-]?secret[_-]?(?:access[_-]?)?key\\s*[:=]\\s*[\"']?[A-Za-z0-9/+=]{40}"
    name: 'AWS Secret Access Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\baws[_-]?session[_-]?token\\s*[:=]\\s*[\"']?[A-Za-z0-9/+=]{100,}"
    name: 'AWS Session Token / AWS STS Token'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\b(?:aws_)?security_token\\s*[:=]\\s*[\"']?[A-Za-z0-9/+=]{100,}"
    name: 'AWS Security Token'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\bcognito[\\w.-]{0,20}\\s*[:=]\\s*[\"']?[a-z]{2}-[a-z]+-\\d:[0-9a-f-]{36}\\b"
    name: 'AWS Cognito Identity Pool Credential'
    priority: 2
    color: '#FFA500'

  - part: 'contents'
    regex: "(?i)\\baws[_-]?codeartifact[\\w.-]{0,20}\\s*[:=]\\s*[\"']?[A-Za-z0-9/+=]{20,}"
    name: 'AWS CodeArtifact Token'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\baws[_-]?code(?:commit|build|deploy|pipeline)[\\w.-]{0,20}\\s*[:=]\\s*[\"']?[A-Za-z0-9/+=]{20,}"
    name: 'AWS CodeCommit / CodeBuild / CodeDeploy / CodePipeline Credential'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: '\bAWS:[A-Za-z0-9+/=]{20,}'
    name: 'AWS ECR Authorization Token'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: 'X-Amz-(?:Credential|Signature|Security-Token)=[A-Za-z0-9%&=/_+.-]{16,}'
    name: 'AWS S3 Presigned URL Credentials'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\baws[_-]?(?:bedrock|sagemaker|kms|secrets[_-]?manager|parameter[_-]?store|lightsail|amplify|appsync|api[_-]?gateway|iot|ses|sns|sqs|eventbridge)[\\w.-]{0,20}\\s*[:=]\\s*[\"']?[A-Za-z0-9/+=]{20,}"
    name: 'AWS Service Credential (Bedrock/SageMaker/KMS/Secrets/ParameterStore/Lightsail/Amplify/AppSync/APIGateway/IoT/SES/SNS/SQS/EventBridge)'
    priority: 2
    color: '#FFA500'

  # ═══════════════════════════════════════════════════════════════════════
  # 2. MAJOR CLOUD PROVIDERS - MICROSOFT AZURE
  # ═══════════════════════════════════════════════════════════════════════

  - part: 'contents'
    regex: "(?i)\\bazure[_-]?client[_-]?secret\\s*[:=]\\s*[\"']?[A-Za-z0-9~._-]{32,}"
    name: 'Azure Client Secret / Service Principal Secret'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\bazure[_-]?client[_-]?id\\s*[:=]\\s*[\"']?[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\\b"
    name: 'Azure Client ID'
    priority: 2
    color: '#FFA500'

  - part: 'contents'
    regex: "(?i)\\bazure[_-]?tenant[_-]?id\\s*[:=]\\s*[\"']?[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\\b"
    name: 'Azure Tenant ID'
    priority: 2
    color: '#FFA500'

  - part: 'contents'
    regex: "(?i)\\bazure[_-]?subscription[_-]?id\\s*[:=]\\s*[\"']?[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\\b"
    name: 'Azure Subscription Credential'
    priority: 2
    color: '#FFA500'

  - part: 'contents'
    regex: "(?i)\\b(?:azure[_-]?)?(?:access|bearer)[_-]?token\\s*[:=]\\s*[\"']?eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}"
    name: 'Azure Access Token'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: '\b[a-z0-9]{52}\b'
    not_regex: "(?i)^(?:[a-f0-9]{52})$"
    name: 'Azure DevOps Personal Access Token'
    priority: 2
    color: '#FFA500'

  - part: 'contents'
    regex: "(?i)\\bazure[_-]?(?:storage[_-]?)?(?:account[_-]?)?key\\s*[:=]\\s*[\"']?[A-Za-z0-9+/]{86}=="
    name: 'Azure Storage Account Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: '[?&](?:sv|sig)=[A-Za-z0-9%&=/_+.-]{16,}'
    name: 'Azure SAS Token'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\bcosmos[\\w.-]{0,20}\\s*[:=]\\s*[\"']?[A-Za-z0-9+/]{86}=="
    name: 'Azure Cosmos DB Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\bazure[_-]?openai[\\w.-]{0,20}\\s*[:=]\\s*[\"']?[a-f0-9]{32}\\b"
    name: 'Azure OpenAI API Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\bazure[_-]?(?:cognitive|maps|communication|signalr)[\\w.-]{0,20}\\s*[:=]\\s*[\"']?[a-zA-Z0-9_-]{32,}\\b"
    name: 'Azure Cognitive Services / Maps / Communication / SignalR Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\b(?:microsoft[_-]?graph|entra[_-]?id|microsoft[_-]?fabric)[\\w.-]{0,20}\\s*[:=]\\s*[\"']?[a-zA-Z0-9._-]{20,}\\b"
    name: 'Microsoft Graph / Entra ID / Fabric Credential'
    priority: 2
    color: '#FFA500'

