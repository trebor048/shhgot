    priority: 2
    color: '#f28c28'
  - part: contents
    regex: (?i)(zilliqa|zil)_address\s*[:=]\s*zil1[a-z0-9]{38,39}
    name: Zilliqa Wallet Address
    priority: 2
    color: '#a65ad9'
  # ================================================================
  # NON-SECRET IDENTIFIERS
  # ================================================================
  - part: contents
    regex: pk\.eyJ[A-Za-z0-9_-]{80,}
    name: Mapbox Public Access Token
    priority: 2
    color: '#6b7280'
  - part: contents
    regex: (api_endpoint|endpoint|base_url|baseurl|base-url)\s*[:=]\s*["\x27]https?://[^\"\x27]{10,}["\x27]
    name: API Endpoint URL in Quotes
    priority: 1
    color: '#7c8798'
  # ================================================================
  # OTHER
  # ================================================================
  - part: contents
    regex: auth0_[A-Za-z0-9]{40}
    name: Auth0 API Token
    priority: 3
    color: '#9ca3af'
  - part: contents
    regex: cloudinary_[A-Za-z0-9]{40}
    name: Cloudinary API Key
    priority: 3
    color: '#9ca3af'
  - part: contents
    regex: firebase_[A-Za-z0-9]{40}
    name: Firebase API Key
    priority: 3
    color: '#9ca3af'
  - part: contents
    regex: (?i)(gemini|palm|bard|makersuite|vertex)[\s_-]*(api[\s_-]*key|token)\s*[:=]\s*["\x27]?(AIza[A-Za-z0-9_-]{35})["\x27]?
    name: Google AI API Key in Assignment
    priority: 3
    color: '#9ca3af'
  - part: contents
    regex: imgix_[A-Za-z0-9]{40}
    name: Imgix API Key
    priority: 3
    color: '#9ca3af'
  - part: contents
    regex: ls__[A-Za-z0-9_-]{40,}
    name: LangSmith Legacy API Key
    priority: 3
    color: '#9ca3af'
  - part: contents
    regex: lsv2_sk_[A-Za-z0-9_-]{40,}
    name: LangSmith V2 API Key
    priority: 3
    color: '#9ca3af'
  - part: contents
    regex: sk\.eyJ[A-Za-z0-9_-]{80,}
    name: Mapbox Secret Access Token
    priority: 3
    color: '#9ca3af'
  - part: contents
    regex: pcsk_[A-Za-z0-9_-]{40,}
    name: Pinecone API Key
    priority: 3
    color: '#9ca3af'
  - part: contents
    regex: phx_[A-Za-z0-9]{40,}
    name: PostHog API Key
    priority: 3
    color: '#9ca3af'
  - part: contents
    regex: (?i)SEED_PHRASE\s*=\s*["\x27]([a-z\s]{35,})["\x27]
    name: SEED_PHRASE Environment Variable
    priority: 3
    color: '#9ca3af'
  - part: contents
    regex: supabase_[A-Za-z0-9]{40}
    name: Supabase API Key
    priority: 3
    color: '#9ca3af'
  - part: filename
    match: .env
    name: Environment Configuration File
    priority: 2
    color: '#9ca3af'
  - part: filename
    match: .openclaw
    name: OpenClaw Configuration File
    priority: 2
    color: '#9ca3af'
  - part: path
    regex: \.openclaw
    name: OpenClaw Directory/File
    priority: 2
    color: '#9ca3af'
  - part: filename
    regex: ^\.?dockercfg
    name: Docker configuration file
    priority: 1
    color: '#9ca3af'
