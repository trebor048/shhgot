  - part: 'contents'
    regex: 'NVIDIA_API_KEY\s*=\s*nvapi-[A-Za-z0-9_-]{20,}'
    name: 'NVIDIA API Key'
    priority: 3
    color: '#d53d46'
  - part: 'contents'
    regex: 'nvapi-[A-Za-z0-9_-]{20,}'
    name: 'NVIDIA API Token'
    priority: 3
    color: '#d53d46'
  - part: 'contents'
    regex: 'Environment\s*=\s*[A-Za-z0-9_]{10,}'
    name: 'Environment Variable Assignment'
    priority: 2
    color: '#d53d46'
  - part: 'contents'
    regex: 'SEED\s*=\s*[A-Za-z0-9]{32,}'
    name: 'Seed/Secret Key'
    priority: 2
    color: '#d53d46'
  - part: 'contents'
    regex: 'phrase\s*=\s*[A-Za-z0-9\s]{20,}'
    name: 'Passphrase/Mnemonic'
    priority: 2
    color: '#d53d46'
  - part: 'filename'
    match: '.openclaw'
    name: 'OpenClaw Configuration File'
    priority: 2
    color: '#d53d46'
  - part: 'path'
    regex: '\.openclaw'
    name: 'OpenClaw Directory/File'
    priority: 2
    color: '#d53d46'

  - part: 'contents'
    regex: 'process\.env\.\w+\s*=\s*["\x27]([^\"\x27]+)["\x27]'
    name: 'Node.js process.env Assignment'
    priority: 2
    color: '#d53d46'
  - part: 'contents'
    regex: 'process\.env\.\w+'
    name: 'Node.js Environment Variable Reference'
    priority: 1
    color: '#d53d46'
  - part: 'contents'
    regex: '(password|passwd|pwd|secret|token|key|api_key|apikey|auth|credential)\s*[:=]\s*["\x27]([^\"\x27]{8,})["\x27]'
    name: 'Quoted Secret Assignment'
    priority: 2
    color: '#FF0000'
  - part: 'contents'
    regex: '(private_key|privatekey|private-key|secret_key|secretkey|secret-key)\s*[:=]\s*["\x27]([^\"\x27]{20,})["\x27]'
    name: 'Private Key in Quotes'
    priority: 3
    color: '#FF0000'
  - part: 'contents'
    regex: '(access_token|accesstoken|access-token|refresh_token|refreshtoken|refresh-token)\s*[:=]\s*["\x27]([^\"\x27]{20,})["\x27]'
    name: 'Token in Quotes'
    priority: 3
    color: '#d53d46'
  - part: 'contents'
    regex: '(username|user|login)\s*[:=]\s*["\x27]([^\"\x27]{3,})["\x27].*?(password|passwd|pwd)\s*[:=]\s*["\x27]([^\"\x27]{3,})["\x27]'
    name: 'Username and Password Pair'
    priority: 3
    color: '#d53d46'
  - part: 'contents'
    regex: '(database_url|db_url|db_connection|connection_string|conn_string)\s*[:=]\s*["\x27]([^\"\x27]{20,})["\x27]'
    name: 'Database Connection String in Quotes'
    priority: 3
    color: '#d53d46'
  - part: 'contents'
    regex: '(webhook|webhook_url|hook_url)\s*[:=]\s*["\x27]https?://[^\"\x27]{20,}["\x27]'
    name: 'Webhook URL in Quotes'
    priority: 2
    color: '#d53d46'
  - part: 'contents'
    regex: '(client_id|clientid|client-id)\s*[:=]\s*["\x27]([^\"\x27]{20,})["\x27]'
    name: 'OAuth Client ID in Quotes'
    priority: 2
    color: '#d53d46'
  - part: 'contents'
    regex: '(client_secret|clientsecret|client-secret)\s*[:=]\s*["\x27]([^\"\x27]{20,})["\x27]'
    name: 'OAuth Client Secret in Quotes'
    priority: 3
    color: '#d53d46'
  - part: 'contents'
    regex: '(jwt|bearer|authorization)\s*[:=]\s*["\x27]([A-Za-z0-9_-]{20,})["\x27]'
    name: 'JWT/Bearer Token in Quotes'
    priority: 3
    color: '#000000'
  - part: 'contents'
    regex: '(mnemonic|seed_phrase|seedphrase|seed-phrase)\s*[:=]\s*["\x27]([a-z\s]{20,})["\x27]'
    name: 'Mnemonic/Seed Phrase in Quotes'
    priority: 3
    color: '#d53d46'
  - part: 'contents'
    regex: '(private_key|privatekey|private-key)\s*[:=]\s*["\x27]0x[A-Fa-f0-9]{60,}["\x27]'
    name: 'Ethereum Private Key in Quotes'
    priority: 3
    color: '#d53d46'
  - part: 'contents'
    regex: '(wallet|address)\s*[:=]\s*["\x27]0x[A-Fa-f0-9]{40}["\x27]'
    name: 'Ethereum Wallet Address in Quotes'
    priority: 2
    color: '#d53d46'
  - part: 'contents'
    regex: '(api_endpoint|endpoint|base_url|baseurl|base-url)\s*[:=]\s*["\x27]https?://[^\"\x27]{10,}["\x27]'
    name: 'API Endpoint URL in Quotes'
    priority: 1
    color: '#d53d46'
  - part: 'contents'
    regex: '(certificate|cert|ssl_cert|sslcert|ssl-cert)\s*[:=]\s*["\x27]-----BEGIN[^\"\x27]{50,}["\x27]'
    name: 'Certificate in Quotes'
    priority: 2
    color: '#d53d46'
  - part: 'contents'
    regex: '(signing_key|signingkey|signing-key|sign_key|signkey|sign-key)\s*[:=]\s*["\x27]([^\"\x27]{20,})["\x27]'
    name: 'Signing Key in Quotes'
    priority: 3
    color: '#d53d46'
  - part: 'contents'
    regex: '(encryption_key|encryptionkey|encryption-key|encrypt_key|encryptkey|encrypt-key)\s*[:=]\s*["\x27]([^\"\x27]{20,})["\x27]'
    name: 'Encryption Key in Quotes'
    priority: 3
    color: '#d53d46'
  - part: 'contents'
    regex: '(session_id|sessionid|session-id|session_token|sessiontoken|session-token)\s*[:=]\s*["\x27]([^\"\x27]{20,})["\x27]'
    name: 'Session Token in Quotes'
    priority: 2
    color: '#d53d46'
  - part: 'contents'
    regex: '(oauth_token|oauthtoken|oauth-token)\s*[:=]\s*["\x27]([^\"\x27]{20,})["\x27]'
    name: 'OAuth Token in Quotes'
    priority: 3
    color: '#d53d46'
  - part: 'contents'
    regex: '(app_secret|appsecret|app-secret)\s*[:=]\s*["\x27]([^\"\x27]{20,})["\x27]'
    name: 'App Secret in Quotes'
    priority: 3
    color: '#d53d46'
  - part: 'contents'
    regex: '(master_key|masterkey|master-key)\s*[:=]\s*["\x27]([^\"\x27]{20,})["\x27]'
    name: 'Master Key in Quotes'
    priority: 3
    color: '#d53d46'
  - part: 'contents'
    regex: '(admin_token|admintoken|admin-token)\s*[:=]\s*["\x27]([^\"\x27]{20,})["\x27]'
    name: 'Admin Token in Quotes'
    priority: 3
    color: '#d53d46'
  - part: 'contents'
    regex: '(root_password|rootpassword|root-password)\s*[:=]\s*["\x27]([^\"\x27]{8,})["\x27]'
    name: 'Root Password in Quotes'
    priority: 3
    color: '#FF0000'
  - part: 'contents'
    regex: '(db_password|dbpassword|db-password|database_password|databasepassword|database-password)\s*[:=]\s*["\x27]([^\"\x27]{8,})["\x27]'
    name: 'Database Password in Quotes'
    priority: 3
    color: '#FF0000'
  - part: 'contents'
    regex: '(ssh_key|sshkey|ssh-key|ssh_password|sshpassword|ssh-password)\s*[:=]\s*["\x27]([^\"\x27]{10,})["\x27]'
    name: 'SSH Credentials in Quotes'
