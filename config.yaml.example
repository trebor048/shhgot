  - part: 'contents'
    regex: '(gcp_key|gcpkey|gcp-key|google_key|googlekey|google-key)\s*[:=]\s*["\x27]([^\"\x27]{20,})["\x27]'
    name: 'GCP/Google Credentials in Quotes'
    priority: 3
