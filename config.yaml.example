  - part: 'contents'
    regex: '(telegram_token|telegramtoken|telegram-token|telegram_bot|telegrambot|telegram-bot)\s*[:=]\s*["\x27]([^\"\x27]{20,})["\x27]'
    name: 'Telegram Credentials in Quotes'
