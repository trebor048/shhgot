  # CRYPTOCURRENCY / BLOCKCHAIN
  # ================================================================
  - part: contents
    regex: (?i)(mnemonic|seed|recovery)[\s_-]*(phrase|words|key)?\s*[:=]\s*\[?\s*["\x27]([a-z]+["\x27]\s*,?\s*){11,23}[a-z]+["\x27]\s*\]?
    name: BIP39 Mnemonic Array Format
    priority: 3
    color: '#f28c28'
  - part: contents
    regex: (?i)(mnemonic|seed_phrase|seedphrase|seed-phrase|recovery_phrase|recoveryphrase|recovery-phrase|bip39|secret_recovery_phrase)\s*[:=]\s*["\x27]([a-z\s]{35,})["\x27]
    name: BIP39 Mnemonic Phrase (Quoted)
    priority: 3
    color: '#a65ad9'
  - part: contents
    regex: (?i)(xpub|xprv|ypub|yprv|zpub|zprv)[a-zA-Z0-9]{107,111}
