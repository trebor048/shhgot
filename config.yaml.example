  - part: 'contents'
    regex: "(?i)\\bbitbucket[\\w.-]{0,20}\\s*[:=]\\s*[\"']?[a-zA-Z0-9_=-]{20,}\\b"
    name: 'Bitbucket API Credential'
    priority: 2
    color: '#FFA500'

  - part: 'contents'
