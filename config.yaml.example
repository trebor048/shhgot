cleanup:
  max_disk_usage_mb: 750          # hard ceiling for the temp directory (default 5120)
  cleanup_threshold_mb: 500       # start evicting once usage passes this
  cleanup_interval_secs: 60       # how often the cleanup pass runs (default 30)

# Per-match-type append logs. Written one file per signature name.
match_log_dir: logs/matches       # default: logs/matches
match_log_enabled: true           # default: true


# Tokens GitHub reports as revoked (HTTP 401) are auto-removed from this file
# at every startup AND while running (a config.yaml.bak backup is written
# first). A 401 during a scan drops the token immediately so it is never
# retried.
github_access_tokens:
  - 'github_pat_YOUR_GITHUB_FINE_GRAINED_PAT_HERE'
  - 'ghp_YOUR_GITHUB_CLASSIC_TOKEN_HERE'

# ---------------------------------------------------------------------------
# Webhook delivery
# ---------------------------------------------------------------------------
# Left commented out because a Discord placeholder fails startup validation:
# the webhook ID must be numeric, so `YOUR_DISCORD_WEBHOOK_HERE` is rejected by
# ValidateDiscordWebhook before the scanner starts. Uncomment a line and paste
# a real URL, or point at an env var (values go through os.ExpandEnv):
#
#   webhook: '$SHHGIT_DISCORD_WEBHOOK'
#
# webhook: 'https://discord.com/api/webhooks/<numeric-id>/<token>'
# webhook_ai_tokens: 'https://discord.com/api/webhooks/<id>/<token>'   # AI-token match class
# webhook_crypto: 'https://discord.com/api/webhooks/<id>/<token>'      # crypto match class

# Body template POSTed to the webhook above. %s is replaced with the match text.
webhook_payload: |
  {
    "text": "%s"
  }

# NOTE: `webhook_queue` is parsed into core.WebhookQueueCfg but the live queue is
# still constructed with hardcoded defaults (1000 slots, 500ms rate limit,
# 300s dedupe window) in core/validators.go. Setting it has no effect today.
# webhook_queue:
#   enabled: true
#   queue_size: 1000
#   rate_limit_ms: 500
#   dedupe_window_sec: 300
#   file_output_enabled: false
#   output_file_path: ''

blacklisted_strings: ["AKIAIOSFODNN7EXAMPLE", "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdef1234", "username:password", "user:pass", "sshpass -p $SSH_PASS"]
blacklisted_extensions: [".exe", ".jpg", ".jpeg", ".png", ".gif", ".zip", ".tar.gz"]
blacklisted_paths: ["node_modules{sep}", "vendor{sep}"]
blacklisted_entropy_extensions: [".pem", "id_rsa", ".asc", ".ovpn", ".sqlite", ".log"]

# ═══════════════════════════════════════════════════════════════════════════
# SIGNATURES - focused set
#
# Scope: database connection strings, AI/LLM API keys, environment files,
# Hugging Face keys, finance/payment API keys, crypto wallets and seeds,
# credential/auth files, and the config files that routinely carry secrets.
#
# Broad, context-free catch-alls were removed on purpose: they matched code
# and prose ("ApiKey = GetRequiredEnvironmentVariable", DB_PASSWORD="$VAR",
# doc-example DSNs) far more often than they matched a real secret. Each rule
# is anchored on the credential's own format or on the config key that names it.
#
# COLOR LEGEND (severity):
#   priority 3 = #FF0000  Critical
#   priority 2 = #FFA500  Medium
#   priority 1 = #FFFF00  Low
#   priority 0 = #808080  Info
# ═══════════════════════════════════════════════════════════════════════════
signatures:
  # ═══════════════════════════════════════════════════════════════════════
  # PRIVATE KEYS
  # ═══════════════════════════════════════════════════════════════════════

  - part: 'contents'
    regex: '-----BEGIN (RSA |DSA |EC |OPENSSH )?PRIVATE KEY-----'
    name: 'Private Key (PEM/OpenSSH)'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: '-----BEGIN PGP PRIVATE KEY BLOCK-----'
    name: 'PGP Private Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: '-----BEGIN ENCRYPTED PRIVATE KEY-----'
    name: 'Encrypted Private Key'
    priority: 2
    color: '#FFA500'

  - part: 'filename'
    regex: '^.*_rsa$'
    name: 'Private SSH Key (RSA, by filename)'
    priority: 3
    color: '#FF0000'

  - part: 'filename'
    regex: '^.*_ed25519$'
    name: 'Private SSH Key (Ed25519, by filename)'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: 'AGE-SECRET-KEY-1[QPZRY9X8GF2TVDW0S3JN54KHCE6MUA7L]{58}'
    name: 'Age Encryption Secret Key'
    priority: 3
    color: '#FF0000'

  # ═══════════════════════════════════════════════════════════════════════
  # AI / LLM API KEYS
  # ═══════════════════════════════════════════════════════════════════════

  - part: 'contents'
    regex: '\bsk-proj-[a-zA-Z0-9_-]{20,}\b'
    name: 'OpenAI Project API Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: '\bsk-svcacct-[a-zA-Z0-9_-]{48,}\b'
    name: 'OpenAI Service Account Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: '\bsk-[a-zA-Z0-9]{48}\b'
    name: 'OpenAI API Key (Legacy)'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: '\bsk-ant-(?:api03-)?[a-zA-Z0-9_-]{90,}\b'
    name: 'Anthropic Claude API Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: '\bxai-[a-zA-Z0-9]{75,}\b'
    name: 'xAI Grok API Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: '\bhf_[A-Za-z0-9]{34}\b'
    name: 'Hugging Face API Token'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: '\bgsk_[A-Za-z0-9]{20,}\b'
    name: 'Groq API Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: '\bpplx-[a-zA-Z0-9]{32,}\b'
    name: 'Perplexity API Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: '\br8_[A-Za-z0-9]{20,}\b'
    name: 'Replicate API Token'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: '\bsk-or-v1-[a-zA-Z0-9]{40,}\b'
    name: 'OpenRouter API Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: '\bnvapi-[A-Za-z0-9_-]{32,}\b'
    name: 'NVIDIA NIM API Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: '\bAIza[0-9A-Za-z_-]{35}\b'
    name: 'Google AI / Gemini API Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\btogether[\\w.-]{0,20}\\s*[:=]\\s*[\"']?[a-f0-9]{64}\\b"
    name: 'Together AI API Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\bstability[\\w.-]{0,20}\\s*[:=]\\s*[\"']?sk-[A-Za-z0-9]{20,60}\\b"
    name: 'Stability AI API Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\bmistral[\\w.-]{0,20}\\s*[:=]\\s*[\"']?[a-zA-Z0-9]{32,}\\b"
    name: 'Mistral AI API Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\bfireworks[\\w.-]{0,20}\\s*[:=]\\s*[\"']?[a-zA-Z0-9]{32,}\\b"
    name: 'Fireworks AI API Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\b(?:elevenlabs|xi-api-key)[\\w.-]{0,20}\\s*[:=]\\s*[\"']?[a-f0-9]{32}\\b"
    name: 'ElevenLabs API Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\bdeepseek[\\w.-]{0,20}\\s*[:=]\\s*[\"']?sk-[a-zA-Z0-9]{32,}\\b"
    name: 'DeepSeek API Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\bassemblyai[\\w.-]{0,20}\\s*[:=]\\s*[\"']?[a-f0-9]{32}\\b"
    name: 'AssemblyAI API Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\bazure[_-]?openai[\\w.-]{0,20}\\s*[:=]\\s*[\"']?[a-f0-9]{32}\\b"
    name: 'Azure OpenAI API Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\bcerebras[\\w.-]{0,20}\\s*[:=]\\s*[\"']?[a-zA-Z0-9_-]{32,}\\b"
    name: 'Cerebras API Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\bcohere[\\w.-]{0,20}\\s*[:=]\\s*[\"']?[a-zA-Z0-9_-]{40}\\b"
    name: 'Cohere API Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\bdeepgram[\\w.-]{0,20}\\s*[:=]\\s*[\"']?[a-f0-9]{40}\\b"
    name: 'Deepgram API Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\bsambanova[\\w.-]{0,20}\\s*[:=]\\s*[\"']?[a-zA-Z0-9_-]{32,}\\b"
    name: 'SambaNova API Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\b(?:zhipu|glm|bigmodel)[\\w.-]{0,20}\\s*[:=]\\s*[\"']?[a-zA-Z0-9._-]{32,}\\b"
    name: 'Zhipu / GLM API Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\b(?:moonshot|kimi)[\\w.-]{0,20}\\s*[:=]\\s*[\"']?sk-[a-zA-Z0-9]{32,}\\b"
    name: 'Moonshot / Kimi API Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\bminimax[\\w.-]{0,20}\\s*[:=]\\s*[\"']?[a-zA-Z0-9._-]{32,}\\b"
    name: 'MiniMax API Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\bbaseten[\\w.-]{0,20}\\s*[:=]\\s*[\"']?[a-zA-Z0-9._-]{20,}\\b"
    name: 'Baseten API Key'
    priority: 3
    color: '#FF0000'

  # ═══════════════════════════════════════════════════════════════════════
  # CLOUD & VERSION-CONTROL AUTH TOKENS
  # ═══════════════════════════════════════════════════════════════════════

  - part: 'contents'
    regex: '\b(?:A3T[A-Z0-9]|AKIA|AGPA|AIDA|AROA|AIPA|ANPA|ANVA|ASIA)[A-Z0-9]{16}\b'
    name: 'AWS Access Key ID'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\baws[_-]?secret[_-]?(?:access[_-]?)?key\\s*[:=]\\s*[\"']?[A-Za-z0-9/+=]{40}\\b"
    name: 'AWS Secret Access Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: '\bghp_[a-zA-Z0-9]{36}\b'
    name: 'GitHub Personal Access Token'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: '\bgithub_pat_[0-9a-zA-Z_]{80,}\b'
    name: 'GitHub Fine-Grained PAT'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: '\bgho_[a-zA-Z0-9]{36}\b'
    name: 'GitHub OAuth Access Token'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: '\bghu_[a-zA-Z0-9]{36}\b'
    name: 'GitHub User-to-Server Token'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: '\bghs_[a-zA-Z0-9]{36}\b'
    name: 'GitHub Server-to-Server Token'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: '\bghr_[a-zA-Z0-9]{36}\b'
    name: 'GitHub Refresh Token'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: '\bglpat-[a-zA-Z0-9_-]{20,}\b'
    name: 'GitLab Personal Access Token'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: '\bglrt-[a-zA-Z0-9_-]{20}\b'
    name: 'GitLab Runner Token'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: '\bdop_v1_[a-f0-9]{64}\b'
    name: 'DigitalOcean Personal Access Token'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: '\bnpm_[a-zA-Z0-9]{36}\b'
    name: 'NPM Access Token'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: '\bpypi-AgEIcHlwaS5vcmc[a-zA-Z0-9_-]{50,}\b'
    name: 'PyPI API Token'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: '\bdckr_pat_[a-zA-Z0-9_-]{20,}\b'
    name: 'Docker Hub Personal Access Token'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: '\bHRKU-AA[0-9a-zA-Z_-]{58}\b'
    name: 'Heroku API Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: '\bya29\.[0-9A-Za-z_-]{20,}\b'
    name: 'Google OAuth Access Token'
    priority: 3
    color: '#FF0000'

  # ═══════════════════════════════════════════════════════════════════════
  # DATABASE CONNECTION STRINGS (credentials embedded in the URL)
  # ═══════════════════════════════════════════════════════════════════════

  - part: 'contents'
    regex: "(?i)mongodb(?:\\+srv)?://[^:\\s\"']+:[^@\\s\"']+@[^\\s\"']+"
    not_regex: "(?i)://(?:localhost|127\\.0\\.0\\.1|example|test|demo|user:pass)|:(?:password|changeme|postgres|root|admin)@"
    name: 'MongoDB Connection String with Credentials'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)postgres(?:ql)?://[^:\\s\"']+:[^@\\s\"']+@[^\\s\"']+"
    not_regex: "(?i)://(?:localhost|127\\.0\\.0\\.1|example|test|demo|user:pass)|:(?:password|changeme|postgres|root|admin)@"
    name: 'PostgreSQL Connection String with Credentials'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)mysql://[^:\\s\"']+:[^@\\s\"']+@[^\\s\"']+"
    not_regex: "(?i)://(?:localhost|127\\.0\\.0\\.1|example|test|demo|user:pass)|:(?:password|changeme|postgres|root|admin)@"
    name: 'MySQL Connection String with Credentials'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)mariadb://[^:\\s\"']+:[^@\\s\"']+@[^\\s\"']+"
    not_regex: "(?i)://(?:localhost|127\\.0\\.0\\.1|example|test|demo|user:pass)|:(?:password|changeme|postgres|root|admin)@"
    name: 'MariaDB Connection String with Credentials'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)redis://[^:\\s\"']*:[^@\\s\"']+@[^\\s\"']+"
    not_regex: "(?i)://(?:localhost|127\\.0\\.0\\.1|example|test|demo)|:(?:password|changeme|redis)@"
    name: 'Redis Connection String with Credentials'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)(?:mssql|sqlserver)://[^:\\s\"']+:[^@\\s\"']+@[^\\s\"']+"
    not_regex: "(?i)://(?:localhost|127\\.0\\.0\\.1|example|test|demo|user:pass)|:(?:password|changeme|sa|root|admin)@"
    name: 'SQL Server Connection String with Credentials'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)cockroach(?:db)?://[^:\\s\"']+:[^@\\s\"']+@[^\\s\"']+"
    not_regex: "(?i)://(?:localhost|127\\.0\\.0\\.1|example|test|demo|user:pass)|:(?:password|changeme|root|admin)@"
    name: 'CockroachDB Connection String with Credentials'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)amqps?://[^:\\s\"']+:[^@\\s\"']+@[^\\s\"']+"
    not_regex: "(?i)://(?:localhost|127\\.0\\.0\\.1|example|test|demo|user:pass)|:(?:password|changeme|guest|admin)@"
    name: 'AMQP / RabbitMQ Connection String with Credentials'
    priority: 3
    color: '#FF0000'

  # ═══════════════════════════════════════════════════════════════════════
  # FINANCE / PAYMENT API KEYS
  # ═══════════════════════════════════════════════════════════════════════

  - part: 'contents'
    regex: '\bsk_live_[0-9a-zA-Z]{24,}\b'
    name: 'Stripe Live Secret Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: '\brk_live_[0-9a-zA-Z]{24,}\b'
    name: 'Stripe Live Restricted Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: '\bwhsec_[0-9a-zA-Z_-]{32,}\b'
    name: 'Stripe Webhook Secret'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: '\bsk_test_[0-9a-zA-Z]{24,}\b'
    name: 'Stripe Test Secret Key'
    priority: 2
    color: '#FFA500'

  - part: 'contents'
    regex: '\bsq0atp-[0-9A-Za-z_-]{22}\b'
    name: 'Square Access Token'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: '\bsq0csp-[0-9A-Za-z_-]{43}\b'
    name: 'Square OAuth Secret'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: '\baccess_token\$production\$[0-9a-z]{16}\$[0-9a-f]{32}\b'
    name: 'PayPal / Braintree Access Token'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: '\brzp_(?:live|test)_[a-zA-Z0-9]{14,}\b'
    name: 'Razorpay Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: '\bFLWSECK(?:_TEST)?-[0-9a-f]{32}-X\b'
    name: 'Flutterwave Secret Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\bcoinbase[\\w.-]{0,20}\\s*[:=]\\s*[\"']?[A-Za-z0-9_-]{20,}\\b"
    name: 'Coinbase API Key'
    priority: 2
    color: '#FFA500'

  - part: 'contents'
    regex: "(?i)\\bbinance[_-]?(?:api[_-]?)?(?:key|secret)\\s*[:=]\\s*[\"']?[A-Za-z0-9]{64}\\b"
    name: 'Binance API Key / Secret'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\bplaid[\\w.-]{0,20}\\s*[:=]\\s*[\"']?[a-f0-9]{24,}\\b"
    name: 'Plaid API Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\badyen[\\w.-]{0,20}\\s*[:=]\\s*[\"']?[A-Za-z0-9_]{32,}\\b"
    name: 'Adyen API Key'
    priority: 2
    color: '#FFA500'

  - part: 'contents'
    regex: "(?i)\\bklarna[\\w.-]{0,20}\\s*[:=]\\s*[\"']?[A-Za-z0-9_-]{32,}\\b"
    name: 'Klarna API Key'
    priority: 2
    color: '#FFA500'

  - part: 'contents'
    regex: "(?i)\\bpaystack[\\w.-]{0,20}\\s*[:=]\\s*[\"']?sk_(?:live|test)_[a-zA-Z0-9]{40,}\\b"
    name: 'Paystack Secret Key'
    priority: 3
    color: '#FF0000'

  # ═══════════════════════════════════════════════════════════════════════
  # CRYPTO WALLETS & SEEDS
  # ═══════════════════════════════════════════════════════════════════════

  - part: 'contents'
    regex: "(?i)\\b(?:eth|ethereum)[_-]?(?:private[_-]?key|secret)\\s*[:=]\\s*[\"']?0x[a-fA-F0-9]{64}\\b"
    name: 'Ethereum Private Key (labeled)'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\b(?:btc|bitcoin)[_-]?(?:private[_-]?key|wif|secret)\\s*[:=]\\s*[\"']?[5KL][1-9A-HJ-NP-Za-km-z]{50,51}\\b"
    name: 'Bitcoin WIF Private Key (labeled)'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\b(?:sol|solana)[_-]?(?:private[_-]?key|secret)\\s*[:=]\\s*[\"']?[1-9A-HJ-NP-Za-km-z]{87,88}\\b"
    name: 'Solana Private Key (labeled)'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\b(?:secretKey|privateKey|keypair)\\s*[:=]\\s*\\[(?:\\s*\\d{1,3}\\s*,){63}\\s*\\d{1,3}\\s*\\]"
    name: 'Solana Keypair Array'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\b(?:wallet|crypto)[_-]?(?:private[_-]?key|priv[_-]?key|secret[_-]?key)\\s*[:=]\\s*[\"'][a-zA-Z0-9]{40,}[\"']"
    not_regex: "(?i)[\"'](?:aws|paste|from|crypto|generated)\\b"
    name: 'Crypto Private Key (labeled)'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\b(?:mnemonic|seed[_-]?phrase|recovery[_-]?phrase)\\s*[:=]\\s*[\"'][a-z]+(?:\\s+[a-z]+){10,23}[\"']"
    not_regex: "(?i)[\"'](?:paste|your|enter)\\b"
    name: 'Crypto Mnemonic / Seed Phrase (labeled)'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)[\"'](?:privateKey|secretKey|mnemonic|seedPhrase|recoveryPhrase)[\"']\\s*:\\s*[\"'][^\"']{40,}[\"']"
    name: 'Crypto Secret JSON Field'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: '\b(?:xprv|yprv|zprv|tprv)[1-9A-HJ-NP-Za-km-z]{70,120}\b'
    name: 'Extended Private Key (xprv)'
    priority: 3
    color: '#FF0000'

  # ═══════════════════════════════════════════════════════════════════════
  # ENVIRONMENT FILES
  # ═══════════════════════════════════════════════════════════════════════

  - part: 'filename'
    match: '.env'
    name: 'Environment File'
    priority: 3
    color: '#FF0000'

  - part: 'filename'
    regex: '^\.[a-z]*env\.(?:local|production|prod|development|dev|staging|stage|test)$'
    name: 'Environment File Variant'
    priority: 2
    color: '#FFA500'

  # ═══════════════════════════════════════════════════════════════════════
  # AUTH & CREDENTIAL FILES
  # ═══════════════════════════════════════════════════════════════════════

  - part: 'path'
    regex: "(?i)\\.?aws/credentials$"
    name: 'AWS Credentials File'
    priority: 3
    color: '#FF0000'

  - part: 'filename'
    regex: '^\.[a-z]*git-credentials$'
    name: 'Git Credentials File'
    priority: 3
    color: '#FF0000'

  - part: 'filename'
    match: '.dockercfg'
    name: 'Docker Config File (legacy)'
    priority: 3
    color: '#FF0000'

  - part: 'path'
    regex: "\\.docker/config\\.json$"
    name: 'Docker Auth Config'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?im)^\\s*(?://[^\\s=]+:)?_authToken\\s*=\\s*[A-Za-z0-9_\\-+/=]{20,}\\s*$"
    name: 'NPM Registry Auth Token'
    priority: 3
    color: '#FF0000'

  - part: 'filename'
    match: '.htpasswd'
    name: 'Apache htpasswd File'
    priority: 3
    color: '#FF0000'

  - part: 'filename'
    regex: '^\.[a-z]*netrc$'
    name: 'Netrc Credentials File'
    priority: 3
    color: '#FF0000'

  - part: 'filename'
    regex: '^\.?pgpass$'
    name: 'PostgreSQL Password File'
    priority: 3
    color: '#FF0000'

  - part: 'filename'
    regex: '^\.?my\.cnf$'
    name: 'MySQL Client Config File'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: '"type"\s*:\s*"service_account"'
    name: 'GCP Service Account Key'
    priority: 3
    color: '#FF0000'

  - part: 'extension'
    match: '.kdbx'
    name: 'KeePass Password Manager Database'
    priority: 2
    color: '#FFA500'

  - part: 'extension'
    match: '.agilekeychain'
    name: '1Password Database'
    priority: 2
    color: '#FFA500'

  - part: 'extension'
    match: '.jks'
    name: 'Java Keystore File'
    priority: 2
    color: '#FFA500'

  - part: 'extension'
    match: '.p12'
    name: 'PKCS12 Certificate Bundle'
    priority: 2
    color: '#FFA500'

  - part: 'extension'
    match: '.pfx'
    name: 'PFX Certificate Bundle'
    priority: 2
    color: '#FFA500'

  # ═══════════════════════════════════════════════════════════════════════
  # CONFIGURATION FILES THAT ROUTINELY CARRY SECRETS
  # ═══════════════════════════════════════════════════════════════════════

  - part: 'filename'
    match: 'database.yml'
    name: 'Rails Database Configuration'
    priority: 2
    color: '#FFA500'

  - part: 'filename'
    regex: '^(?:wp-config|config(?:\.inc)?)\.php$'
    name: 'PHP Configuration File'
    priority: 2
    color: '#FFA500'

  - part: 'filename'
    match: 'LocalSettings.php'
    name: 'MediaWiki Configuration'
    priority: 2
    color: '#FFA500'

  - part: 'filename'
    match: 'terraform.tfvars'
    name: 'Terraform Variables File'
    priority: 2
    color: '#FFA500'

  - part: 'filename'
    match: 'application.properties'
    name: 'Spring Configuration File'
    priority: 2
    color: '#FFA500'

  - part: 'filename'
    match: 'web.config'
    name: 'ASP.NET Configuration File'
    priority: 2
    color: '#FFA500'

  - part: 'filename'
    regex: '^\.?gitconfig$'
    name: 'Git Configuration File'
    priority: 1
    color: '#FFFF00'
