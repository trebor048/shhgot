    name: 'Hugging Face API Key in Assignment'
    priority: 3
    color: '#d53d46'
  - part: 'contents'
    regex: '(?i)(together|togetherai)[\s_-]*(api[\s_-]*key|token)\s*[:=]\s*["\x27]?([A-Za-z0-9]{40,})["\x27]?'
    name: 'Together AI API Key in Assignment'
    priority: 3
    color: '#d53d46'
  - part: 'contents'
    regex: '(?i)(replicate)[\s_-]*(api[\s_-]*key|token)\s*[:=]\s*["\x27]?(r8_[A-Za-z0-9]{20,})["\x27]?'
    name: 'Replicate API Key in Assignment'
    priority: 3
    color: '#d53d46'
  - part: 'contents'
    regex: '(?i)(anthropic|claude)[\s_-]*(api[\s_-]*key|token)\s*[:=]\s*["\x27]?(sk-ant-[A-Za-z0-9_-]{95,})["\x27]?'
    name: 'Anthropic Claude API Key in Assignment'
    priority: 3
    color: '#d53d46'
  - part: 'contents'
    regex: '(?i)(openai|gpt)[\s_-]*(api[\s_-]*key|token)\s*[:=]\s*["\x27]?(sk-[A-Za-z0-9]{48})["\x27]?'
    name: 'OpenAI API Key in Assignment'
    priority: 3
    color: '#d53d46'

  # PRIORITY 2 - HIGH
  - part: 'contents'
    regex: '(?i)(password|passwd|pwd)\s*[:=]\s*[A-Za-z0-9]{8,}'
    name: 'Password in configuration'
    priority: 2
    color: '#FF0000'
  - part: 'contents'
    regex: '(?i)(api_?key|apikey|api_?secret|secret_?key)\s*[:=]\s*[A-Za-z0-9]{16,}'
    name: 'API Key or Secret in configuration'
    priority: 2
    color: '#FF6600'
  - part: 'filename'
    regex: '(dump|logs)\.sql'
    name: 'SQL database dump/logs'
    priority: 2
    color: '#00758F'
  - part: 'filename'
    match: 'credentials.xml'
    name: 'Jenkins credentials file'
    priority: 2
    color: '#D33833'
  - part: 'extension'
    match: '.pem'
    name: 'Cryptographic private key'
    priority: 2
    color: '#FF0000'
  - part: 'filename'
    regex: '^\.?(netrc|git-credentials|npmrc)'
    name: 'Sensitive configuration files'
    priority: 2
    color: '#F1502F'

  # PRIORITY 1 - LOW
  - part: 'filename'
    regex: '^\.?env\.(production|development|local)'
    name: 'Environment file variant'
    priority: 1
    color: '#ECD53F'
  - part: 'path'
    regex: '\.?aws/credentials'
    name: 'AWS CLI credentials file'
    priority: 1
    color: '#FF9900'
  - part: 'filename'
    regex: '^\.?gitconfig'
    name: 'Git configuration file'
    priority: 1
    color: '#F1502F'
  - part: 'filename'
    regex: '^\.?dockercfg'
    name: 'Docker configuration file'
    priority: 1
    color: '#2496ED'
  - part: 'filename'
    regex: '^\.?bash_history'
    name: 'Bash history file'
    priority: 1
    color: '#89E051'
  - part: 'contents'
    regex: 'Configuration\[["\x27]([\w_]+)["\x27]\]'
    name: 'C# Configuration Access'
    priority: 1
    color: '#239120'
  - part: 'contents'
    regex: '\$_ENV\[["\x27]([\w_]+)["\x27]\]'
    name: 'PHP $_ENV Access'
    priority: 1
    color: '#777BB4'
  - part: 'contents'
    regex: '\$_SERVER\[["\x27]([\w_]+)["\x27]\]'
    name: 'PHP $_SERVER Access'
    priority: 1
    color: '#777BB4'


  # ============================================================
  # REQUEST HEADER AUTHENTICATION
  # Catches auth material smuggled in HTTP request headers and
  # cookie jars: authorization, cookies, Cloudflare (CF) tokens,
  # API keys, passwords, usernames, session ids, JWTs and wallet
  # credentials.
  # ============================================================

  - part: 'contents'
    regex: '(?i)\b(?:authorization|proxy-authorization)\s*[:=]\s*(?:(?:basic|digest)\s+[a-zA-Z0-9._~+/=, -]{8,}|(?:bearer|token)\s+[a-zA-Z0-9._~+/=-]{20,}|[a-zA-Z0-9._~+=-]{16,})'
    name: 'Authorization Header'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: '(?i)\b(?:cookie|set-cookie)\s*[:=]\s*[^\r\n]{0,120}(?:session|token|auth|jwt|sid|access|refresh|cf_|__cf|wordpress|login|remember|logged_in|credential)[^\r\n]{0,300}'
    name: 'Authentication Cookie Header'
    priority: 3
    color: '#d53d46'

  - part: 'contents'
    regex: '(?i)\b(?:phpsessid|jsessionid|connect\.sid|cf_clearance|_cfuvid|__cf_bm|__cfruid|cf_authorization)\s*=\s*[a-zA-Z0-9._%+/=-]{10,}'
    name: 'Session/Cookie Secret'
    priority: 3
    color: '#d53d46'

  - part: 'contents'
    regex: '(?i)\b(?:cf-access-token|cf_access_token|cf-access-client-secret|cf_access_client_secret|cf-access-client-id|cf_access_client_id)\s*[:=]\s*[a-zA-Z0-9._~+/=-]{16,}'
    name: 'Cloudflare Access Credential'
    priority: 3
    color: '#F38020'

  - part: 'contents'
    regex: '(?i)\bcf[-_]authorization\s*[:=]\s*eyJ[a-zA-Z0-9._~+/=-]{20,}'
    name: 'Cloudflare Access JWT'
    priority: 3
    color: '#F38020'

  - part: 'contents'
    regex: '(?i)\b(?:x-)?(?:api[-_]?key|api[-_]?token|api[-_]?secret|access[-_]?token|refresh[-_]?token|auth[-_]?token|auth[-_]?key|auth[-_]?secret|client[-_]?secret|client[-_]?id)\s*[:=]\s*[a-zA-Z0-9._~+/=-]{16,}'
    name: 'API Authentication Header'
    priority: 3
    color: '#d53d46'

  - part: 'contents'
    regex: '(?i)\b(?:x-)?(?:github|gitlab|goog|google|gcp|aws|azure|cloudflare|cf|slack|stripe|discord|telegram|openai|anthropic)[-_ ]?(?:api)?[-_ ]?(?:key|token|secret|access[-_]?token)\s*[:=]\s*[a-zA-Z0-9._~+/=-]{12,}'
    name: 'Provider Token Header'
    priority: 3
    color: '#d53d46'

  - part: 'contents'
    regex: '(?i)\b(?:authorization|cookie|token|x-jwt|jwt)\s*[:=]\s*eyJ[a-zA-Z0-9_-]{10,}\.[a-zA-Z0-9_-]{4,}\.[a-zA-Z0-9_-]{10,}'
    name: 'JWT in Header/Cookie'
    priority: 3
    color: '#000000'

  - part: 'contents'
    regex: '(?i)\b(?:x-)?(?:password|passwd|pwd)\s*[:=]\s*[a-zA-Z0-9._~+/=!@#$%^&*()-]{8,}'
    name: 'Password Header'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: '(?i)\b(?:x-user|x-username|user[-_]?name)\s*[:=]\s*[a-zA-Z0-9._@+-]{3,}'
    name: 'Username Header'
    priority: 2
    color: '#d53d46'

  - part: 'contents'
    regex: '(?i)\b(?:x-session|x-session[-_]?token|x-session[-_]?id|session[-_]?token|session[-_]?id)\s*[:=]\s*[a-zA-Z0-9._~+/=-]{8,}'
    name: 'Session Header'
    priority: 2
    color: '#d53d46'

  - part: 'contents'
    regex: '(?i)\b(?:x-wallet|x-wallet[-_]?(?:address|key|secret)|wallet[-_]?(?:address|key|secret))\s*[:=]\s*(?:0x)?[a-zA-Z0-9]{20,}'
    name: 'Wallet Credential Header'
    priority: 3
    color: '#F7931A'

  - part: 'contents'
    regex: '(?i)\b(?:x-crypto|x-private[-_]?key|x-secret)\s*[:=]\s*(?:0x)?[a-zA-Z0-9]{20,}'
    name: 'Crypto Key Header'
    priority: 3
    color: '#F7931A'

