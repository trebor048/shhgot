  - part: 'contents'
    regex: "(?i)\\bmurf[\\w.-]{0,20}\\s*[:=]\\s*[\"']?[a-zA-Z0-9_-]{20,}\\b"
    name: 'Murf AI API Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\bresemble[\\w.-]{0,20}\\s*[:=]\\s*[\"']?[a-zA-Z0-9_-]{20,}\\b"
    name: 'Resemble AI API Key'
    priority: 3
