  - part: 'contents'
    regex: "(?i)\\bfirebase[\\w.-]{0,20}\\s*[:=]\\s*[\"']?AIza[0-9A-Za-z_-]{35}"
    name: 'Firebase API Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\bfirebase[\\w.-]{0,20}(?:admin|service[_-]?account)[\\w.-]{0,20}\\s*[:=]\\s*[\"']?[a-zA-Z0-9_-]{20,}\\b"
    name: 'Firebase Service Account / Admin SDK Credential'
    priority: 3
