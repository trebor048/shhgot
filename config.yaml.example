    regex: "(?i)\\bazure[_-]?iot[\\w.-]{0,20}\\s*[:=]\\s*[\"']?[A-Za-z0-9_~.-]{20,}\b"
    name: 'Azure IoT Credential'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\bgoogle[_-]?cloud[\\w.-]{0,20}iot[\\w.-]{0,20}\\s*[:=]\\s*[\"']?AIza[0-9A-Za-z_-]{35}"
    name: 'Google Cloud IoT Credential'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: '\bBBFF-[A-Za-z0-9_-]{20,}'
    name: 'Ubidots API Token'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\bdatacake[\\w.-]{0,20}\\s*[:=]\\s*[\"']?[A-Za-z0-9_-]{20,}\b"
    name: 'Datacake API Token'
    priority: 2
    color: '#FFA500'

  - part: 'contents'
    regex: "(?i)\\bbalena[\\w.-]{0,20}\\s*[:=]\\s*[\"']?[A-Za-z0-9_-]{20,}\b"
    name: 'Balena API Token'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\bemqx[\\w.-]{0,20}\\s*[:=]\\s*[\"']?[A-Za-z0-9_.-]{20,}\b"
    name: 'EMQX API Credential'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\bhivemq[\\w.-]{0,20}\\s*[:=]\\s*[\"']?[A-Za-z0-9_.-]{20,}\b"
    name: 'HiveMQ API Credential'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\bthingspeak[\\w.-]{0,20}\\s*[:=]\\s*[\"']?[A-Z0-9]{16}\b"
    name: 'ThingSpeak API Key'
    priority: 3
    color: '#FF0000'

  # ═══════════════════════════════════════════════════════════════════════
  # GENERIC CREDENTIAL CORPUS - GENERIC API FORMATS
  # ═══════════════════════════════════════════════════════════════════════

  - part: 'contents'
    regex: "(?i)\\b(?:api[_-]?key|apikey|api-key|apiToken|api[_-]?token|api-token)\\s*[:=]\\s*[\"']?[A-Za-z0-9_\\-]{20,}"
    not_regex: "(?i)(?:your|example|placeholder|changeme|change_me|replace|xxxx|dummy|sample|test|demo|foo|bar)"
    name: 'Generic API Key / Token'
    priority: 2
    color: '#FFA500'

  - part: 'contents'
    regex: "(?i)\\b(?:access[_-]?key|accessKey|access[_-]?token|accessToken|auth[_-]?token|authToken)\\s*[:=]\\s*[\"']?[A-Za-z0-9_.\\-]{20,}"
    not_regex: "(?i)(?:your|example|placeholder|changeme|change_me|replace|xxxx|dummy|sample|test|demo|foo|bar)"
    name: 'Generic Access Key / Access Token / Auth Token'
    priority: 2
    color: '#FFA500'

  - part: 'contents'
    regex: "(?i)\\b(?:client[_-]?key|clientKey|client[_-]?secret|clientSecret|consumer[_-]?key|consumerKey|consumer[_-]?secret|consumerSecret)\\s*[:=]\\s*[\"']?[A-Za-z0-9_.\\-]{20,}"
    not_regex: "(?i)(?:your|example|placeholder|changeme|change_me|replace|xxxx|dummy|sample|test|demo|foo|bar)"
    name: 'Generic Client / Consumer Key or Secret'
    priority: 2
    color: '#FFA500'

  - part: 'contents'
    regex: "(?i)\\b(?:developer[_-]?key|developerKey|developer[_-]?token|dev[_-]?token|integration[_-]?key|integration[_-]?token)\\s*[:=]\\s*[\"']?[A-Za-z0-9_.\\-]{20,}"
    not_regex: "(?i)(?:your|example|placeholder|changeme|change_me|replace|xxxx|dummy|sample|test|demo|foo|bar)"
    name: 'Generic Developer / Integration Key or Token'
    priority: 2
    color: '#FFA500'

  - part: 'contents'
    regex: "(?i)\\b(?:private[_-]?key|public[_-]?key|secret|secret[_-]?key|secretKey|secret[_-]?token|service[_-]?key|service[_-]?token)\\s*[:=]\\s*[\"']?[A-Za-z0-9_+/=.\\-]{20,}"
    not_regex: "(?i)(?:your|example|placeholder|changeme|change_me|replace|xxxx|dummy|sample|test|demo|foo|bar)"
    name: 'Generic Private / Public / Secret / Service Key'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\b(?:signing[_-]?key|signing[_-]?secret|webhook[_-]?secret|webhook[_-]?token|application[_-]?key|application[_-]?secret)\\s*[:=]\\s*[\"']?[A-Za-z0-9_+/=.\\-]{20,}"
    not_regex: "(?i)(?:your|example|placeholder|changeme|change_me|replace|xxxx|dummy|sample|test|demo|foo|bar)"
    name: 'Generic Signing / Webhook / Application Key or Secret'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\b(?:project[_-]?key|project[_-]?token|organization[_-]?key|organization[_-]?token|account[_-]?key|account[_-]?token)\\s*[:=]\\s*[\"']?[A-Za-z0-9_+/=.\\-]{20,}"
    not_regex: "(?i)(?:your|example|placeholder|changeme|change_me|replace|xxxx|dummy|sample|test|demo|foo|bar)"
    name: 'Generic Project / Organization / Account Key or Token'
    priority: 2
    color: '#FFA500'

  # ═══════════════════════════════════════════════════════════════════════
  # GENERIC CREDENTIAL CORPUS - HTTP AUTHENTICATION HEADERS
  # ═══════════════════════════════════════════════════════════════════════

  - part: 'contents'
    regex: "(?i)Authorization:\\s*Bearer\\s+[A-Za-z0-9_\\-.=]{20,}"
    not_regex: "(?i)(?:your|example|placeholder|changeme|replace|xxxx|dummy|sample|test|demo)"
    name: 'HTTP Authorization: Bearer Token'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)Authorization:\\s*Basic\\s+[A-Za-z0-9+/=]{20,}"
    not_regex: "(?i)(?:dXNlcjpwYXNz|dXNlcm5hbWU6cGFzc3dvcmQ=)"
    name: 'HTTP Authorization: Basic Credentials'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)Authorization:\\s*Token\\s+[A-Za-z0-9_\\-.=]{20,}"
    not_regex: "(?i)(?:your|example|placeholder|changeme|replace|xxxx|dummy|sample|test|demo)"
    name: 'HTTP Authorization: Token'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)Authorization:\\s*OAuth\\s+[A-Za-z0-9_\\-.=]{20,}"
    not_regex: "(?i)(?:your|example|placeholder|changeme|replace|xxxx|dummy|sample|test|demo)"
    name: 'HTTP Authorization: OAuth Token'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)X-(?:API|Api|Auth|Access|Client|Secret)-(?:Key|Token|Secret):\\s*[A-Za-z0-9_\\-.=]{20,}"
    not_regex: "(?i)(?:your|example|placeholder|changeme|replace|xxxx|dummy|sample|test|demo)"
    name: 'HTTP X-API-Key / X-Auth-Token / X-Client-Secret Header'
    priority: 3
    color: '#FF0000'

  # ═══════════════════════════════════════════════════════════════════════
  # GENERIC CREDENTIAL CORPUS - ENVIRONMENT VARIABLES
  # ═══════════════════════════════════════════════════════════════════════

  - part: 'contents'
    regex: "(?i)\\b(?:API_KEY|API_SECRET|API_TOKEN|AUTH_TOKEN|ACCESS_TOKEN|REFRESH_TOKEN|CLIENT_ID|CLIENT_SECRET|SECRET_KEY|PRIVATE_KEY|PUBLIC_KEY|SIGNING_KEY|SIGNING_SECRET|WEBHOOK_SECRET)\\s*[:=]\\s*[\"']?[A-Za-z0-9_+/=.\\-]{20,}"
    not_regex: "(?i)(?:your|example|placeholder|changeme|change_me|replace|xxxx|dummy|sample|test|demo|foo|bar)"
    name: 'Environment Variable: Generic API / Auth / Signing Secret'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\b(?:DATABASE_URL|DATABASE_URI|DB_PASSWORD|DB_USER|DB_HOST|DB_TOKEN|REDIS_URL|MONGO_URI|MONGODB_URI|POSTGRES_URL|MYSQL_URL)\\s*[:=]\\s*[\"']?[^\\s\"']{12,}"
    not_regex: "(?i)(?:localhost|127\\.0\\.0\\.1|example|user:pass|password@|changeme)"
    name: 'Environment Variable: Database Connection / Credential'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\b(?:AWS_ACCESS_KEY_ID|AWS_SECRET_ACCESS_KEY|AWS_SESSION_TOKEN)\\s*[:=]\\s*[\"']?[A-Za-z0-9/+=]{20,}"
    not_regex: "(?i)(?:EXAMPLE|your|placeholder|xxxx)"
    name: 'Environment Variable: AWS Credentials'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\b(?:AZURE_CLIENT_ID|AZURE_CLIENT_SECRET|AZURE_TENANT_ID|GOOGLE_APPLICATION_CREDENTIALS|GOOGLE_API_KEY)\\s*[:=]\\s*[\"']?[A-Za-z0-9_./=+\\-]{16,}"
    not_regex: "(?i)(?:your|example|placeholder|changeme|replace|xxxx|dummy|sample|test|demo)"
    name: 'Environment Variable: Azure / Google Cloud Credentials'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\b(?:GITHUB_TOKEN|GITLAB_TOKEN|NPM_TOKEN|PYPI_TOKEN|DOCKER_PASSWORD|DOCKER_AUTH_CONFIG)\\s*[:=]\\s*[\"']?[A-Za-z0-9_+/=.\\-]{16,}"
    not_regex: "(?i)(?:your|example|placeholder|changeme|change_me|replace|xxxx|dummy|sample|test|demo)"
    name: 'Environment Variable: Registry / VCS Token'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\b(?:OPENAI_API_KEY|ANTHROPIC_API_KEY|GROQ_API_KEY|GEMINI_API_KEY|HF_TOKEN|HUGGINGFACE_TOKEN|STRIPE_SECRET_KEY|STRIPE_PUBLISHABLE_KEY|TWILIO_ACCOUNT_SID|TWILIO_AUTH_TOKEN|SENDGRID_API_KEY|DISCORD_TOKEN|SLACK_TOKEN|SLACK_SIGNING_SECRET)\\s*[:=]\\s*[\"']?[A-Za-z0-9_+/=.\\-]{16,}"
    not_regex: "(?i)(?:your|example|placeholder|changeme|change_me|replace|xxxx|dummy|sample|test|demo)"
    name: 'Environment Variable: AI / Payment / Messaging Provider Key'
    priority: 3
    color: '#FF0000'

  # ═══════════════════════════════════════════════════════════════════════
  # ADDITIONAL COVERAGE
  # ═══════════════════════════════════════════════════════════════════════

  - part: 'contents'
    regex: "(?i)\\bgoogle[_-]?cloud[\\w.-]{0,20}source[\\w.-]{0,20}(?:repo|repository)[\\w.-]{0,20}\\s*[:=]\\s*[\"']?[A-Za-z0-9_.-]{20,}\b"
    name: 'Google Cloud Source Repositories Credential'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\bdigitalocean[\\w.-]{0,20}managed[\\w.-]{0,20}(?:database|db)[\\w.-]{0,20}\\s*[:=]\\s*[\"']?(?:dop_v1_[a-f0-9]{64}|postgres://[^\\s\"']+)"
    name: 'DigitalOcean Managed Databases Credential'
    priority: 3
    color: '#FF0000'
