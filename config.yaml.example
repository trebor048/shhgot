# ============================================================================
# shhgit example configuration
# ============================================================================
# Copy this file to config.yaml and fill in your own values:
#
#     cp config.yaml.example config.yaml
#
# config.yaml is gitignored — never commit real tokens.
# Every key below is recognized by core/config.go. Values shown are safe
# placeholders; the file is not usable until you replace them. Keys the binary
# parses but does not yet act on are called out explicitly in comments.
# ============================================================================

# Performance optimization settings — every key is honored by the scanner
# (core/config.go). Absent keys keep the compiled-in defaults. Values here
# are conservative examples; crank them up for maximum throughput.
performance:
  max_repository_threads: 3
  max_gist_threads: 3
  max_comment_threads: 3
  api_pages_per_cycle: 5
  api_per_page: 100
  api_sleep_seconds: 15
  worker_pool_size: 3
  queue_buffer_size: 2
  max_file_count: 10000            # files processed per repository before skipping

logFormat: "fancy"                 # minimal | fancy | ultra fancy | even more fancy | neon

# Interactive AI-review chat (launched from each match card).
ai_review:
  backend: deepseek               # deepseek | ollama
  deepseek_api_key: ''            # or set the DEEPSEEK_API_KEY env var
  deepseek_model: deepseek-chat
  ollama_url: http://localhost:11434
  ollama_model: hf.co/HauhauCS/Gemma-4-E4B-Uncensored-HauhauCS-Aggressive:Q5_K_M
  # system_prompt: ''            # optional override; a sensible default is built in

ai_tokens:
  # OpenAI and related
  - 'sk-[your-openai-token-here]'
  - 'sk-proj-[your-openai-project-token-here]'
  
  # Anthropic Claude
  - 'sk-ant-api03-[your-claude-token-here]'
  - 'claude_[your-claude-token-alternative]'
  - 'anthropic_[your-anthropic-token]'
  
  # Google AI
  - 'gemini-[your-google-gemini-token-here]'
  - 'AIza[your-google-ai-token-here]'
  - 'PALM-[your-palm-token]'
  - 'makersuite_[your-makersuite-token]'
  - 'vertexai_[your-vertexai-token]'
  - 'palm_[your-palm-token-alt]'
  - 'bard_[your-bard-token]'
  
  # Hugging Face
  - 'hf_[your-huggingface-token-here]'
  - 'huggingface_[your-hf-token-alt]'
  
  # xAI
  - 'xai-[your-xai-grok-token-here]'
  
  # Cohere
  - 'cohere_[your-cohere-token-here]'
  
  # Together AI
