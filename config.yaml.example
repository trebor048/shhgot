    priority: 3
    color: '#FF0000'

  - part: 'contents'
    regex: "(?i)\\bgithub[_-]?(?:actions|app)[\\w.-]{0,20}\\s*[:=]\\s*[\"']?(?:gh[pousr]_[a-zA-Z0-9]{36}|github_pat_[0-9a-zA-Z_]{80,})"
    name: 'GitHub Actions / GitHub Apps Credential'
    priority: 3
    color: '#FF0000'

  - part: 'contents'
