  - part: 'filename'
    match: '.env'
    name: 'Environment Configuration File'
    priority: 3
    color: '#ECD53F'

  # Cryptocurrency & Blockchain
  - part: 'contents'
    regex: '(?i)(private_key|privatekey|private-key|secret_key|secretkey|secret-key)\s*[:=]\s*0x[A-Fa-f0-9]{64}'
    name: 'Ethereum Private Key (256-bit)'
    priority: 3
    color: '#FF0000'
  - part: 'contents'
    regex: '(?i)(wallet|address|eth_address|ethaddress|eth-address|public_key|publickey|public-key)\s*[:=]\s*0x[A-Fa-f0-9]{40}'
    name: 'Ethereum Wallet Address'
    priority: 2
    color: '#F6851B'
  - part: 'contents'
    regex: '0x[A-Fa-f0-9]{64}(?=\s|$|[,;:\)])'
    name: 'Ethereum Private Key (Standalone)'
    priority: 3
    color: '#FF0000'
  - part: 'contents'
    regex: '0x[A-Fa-f0-9]{40}(?=\s|$|[,;:\)])'
    name: 'Ethereum Address (Standalone)'
    priority: 2
    color: '#F6851B'
  - part: 'contents'
    regex: '(?i)(mnemonic|seed_phrase|seedphrase|seed-phrase|recovery_phrase|recoveryphrase|recovery-phrase|bip39|secret_recovery_phrase)\s*[:=]\s*["\x27]([a-z\s]{35,})["\x27]'
    name: 'BIP39 Mnemonic Phrase (Quoted)'
    priority: 3
    color: '#F7931A'
  - part: 'contents'
    regex: '(?i)(mnemonic|seed|recovery)[\s_-]*(phrase|words|key)?\s*[:=]\s*\[?\s*["\x27]([a-z]+["\x27]\s*,?\s*){11,23}[a-z]+["\x27]\s*\]?'
    name: 'BIP39 Mnemonic Array Format'
    priority: 3
    color: '#F7931A'
  - part: 'contents'
    regex: '\b(abandon|ability|able|about|above|absent|absorb|abstract|absurd|abuse|access|accident|account|accuse|achieve|acid|acoustic|acquire|across|act|action|actor|actress|actual|adapt|add|addict|address|adjust|admit|adult|advance|advice|aerobic|affair|afford|afraid|again|age|agent|agree|ahead|aim|air|airport|aisle|alarm|album|alcohol|alert|alien|all|alley|allow|almost|alone|alpha|already|also|alter|always|amateur|amazing|among|amount|amused|analyst|anchor|ancient|anger|angle|angry|animal|ankle|announce|annual|another|answer|antenna|antique|anxiety|any|apart|apology|appear|apple|approve|april|arch|arctic|area|arena|argue|arm|armed|armor|army|around|arrange|arrest|arrive|arrow|art|artefact|artist|artwork|ask|aspect|assault|asset|assist|assume|asthma|athlete|atom|attack|attend|attitude|attract|auction|audit|august|aunt|author|auto|autumn|average|avocado|avoid|awake|aware|away|awesome|awful|awkward|axis|baby|bachelor|bacon|badge|bag|balance|balcony|ball|bamboo|banana|banner|bar|barely|bargain|barrel|base|basic|basket|battle|beach|bean|beauty|because|become|beef|before|begin|behave|behind|believe|below|belt|bench|benefit|best|betray|better|between|beyond|bicycle|bid|bike|bind|biology|bird|birth|bitter|black|blade|blame|blanket|blast|bleak|bless|blind|blood|blossom|blouse|blue|blur|blush|board|boat|body|boil|bomb|bone|bonus|book|boost|border|boring|borrow|boss|bottom|bounce|box|boy|bracket|brain|brand|brass|brave|bread|breeze|brick|bridge|brief|bright|bring|brisk|broccoli|broken|bronze|broom|brother|brown|brush|bubble|buddy|budget|buffalo|build|bulb|bulk|bullet|bundle|bunker|burden|burger|burst|bus|business|busy|butter|buyer|buzz)(\s+\1){11}\b'
    name: 'BIP39 Mnemonic (12 words from wordlist)'
    priority: 3
    color: '#F7931A'
  - part: 'contents'
    regex: '\b([a-z]{3,8}\s+){11}[a-z]{3,8}\b'
    name: 'Potential 12-Word Seed Phrase'
    priority: 2
    color: '#F7931A'
  - part: 'contents'
    regex: '\b([a-z]{3,8}\s+){14}[a-z]{3,8}\b'
    name: 'Potential 15-Word Seed Phrase'
    priority: 2
    color: '#F7931A'
  - part: 'contents'
    regex: '\b([a-z]{3,8}\s+){17}[a-z]{3,8}\b'
    name: 'Potential 18-Word Seed Phrase'
    priority: 2
    color: '#F7931A'
  - part: 'contents'
    regex: '\b([a-z]{3,8}\s+){20}[a-z]{3,8}\b'
    name: 'Potential 21-Word Seed Phrase'
    priority: 2
    color: '#F7931A'
  - part: 'contents'
    regex: '\b([a-z]{3,8}\s+){23}[a-z]{3,8}\b'
    name: 'Potential 24-Word Seed Phrase'
    priority: 2
    color: '#F7931A'
  - part: 'contents'
    regex: '(?i)(seed|mnemonic|recovery).*?:\s*"([a-z]+\s+){11,23}[a-z]+"'
    name: 'Seed Phrase in JSON'
    priority: 3
    color: '#F7931A'
  - part: 'contents'
    regex: '(?i)SEED_PHRASE\s*=\s*["\x27]([a-z\s]{35,})["\x27]'
    name: 'SEED_PHRASE Environment Variable'
    priority: 3
    color: '#F7931A'
  - part: 'contents'
    regex: '(?i)(wallet|account)[\s_-]*(seed|mnemonic|recovery)\s*[:=]\s*["\x27]([a-z\s]{35,})["\x27]'
    name: 'Wallet Seed Assignment'
    priority: 3
    color: '#F7931A'
  - part: 'contents'
    regex: '(?i)(bitcoin|btc)_address\s*[:=]\s*[13][a-km-zA-HJ-NP-Z1-9]{25,34}'
    name: 'Bitcoin Address (P2PKH/P2SH)'
    priority: 2
    color: '#F7931A'
  - part: 'contents'
    regex: '(?i)(bitcoin|btc)_address\s*[:=]\s*bc1[a-z0-9]{39,59}'
    name: 'Bitcoin Address (Bech32)'
    priority: 2
    color: '#F7931A'
  - part: 'contents'
    regex: '(?i)(private_key|privatekey|private-key)\s*[:=]\s*[KL][1-9A-HJ-NP-Za-km-z]{50,51}'
    name: 'Bitcoin Private Key (WIF)'
    priority: 3
    color: '#d53d46'
  - part: 'contents'
    regex: '(?i)(xpub|xprv|ypub|yprv|zpub|zprv)[a-zA-Z0-9]{107,111}'
    name: 'Bitcoin Extended Public/Private Key'
    priority: 3
    color: '#d53d46'
  - part: 'contents'
    regex: '(?i)(solana|sol)_address\s*[:=]\s*[1-9A-HJ-NP-Za-km-z]{43,44}'
    name: 'Solana Wallet Address'
    priority: 2
    color: '#d53d46'
  - part: 'contents'
    regex: '(?i)(solana|sol)_private_key\s*[:=]\s*[A-Za-z0-9+/]{86,88}={0,2}'
    name: 'Solana Private Key (Base64)'
    priority: 3
    color: '#d53d46'
  - part: 'contents'
    regex: '(?i)(cardano|ada)_address\s*[:=]\s*addr1[a-z0-9]{53,58}'
    name: 'Cardano Wallet Address'
    priority: 2
    color: '#d53d46'
  - part: 'contents'
    regex: '(?i)(ripple|xrp)_address\s*[:=]\s*r[a-zA-Z0-9]{24,34}'
    name: 'Ripple/XRP Wallet Address'
    priority: 2
