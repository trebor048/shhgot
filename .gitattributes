# ===========================================================================
# Repository line-ending and file-type policy
#
# Without this, a Windows checkout with core.autocrlf=true produces CRLF in
# the working tree while git stores LF, which makes gofmt and shell scripts
# behave inconsistently between machines and CI.
# ===========================================================================

* text=auto

# Source and scripts must stay LF everywhere.
*.go        text eol=lf
*.sh        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.md        text eol=lf
*.json      text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.js        text eol=lf
Makefile    text eol=lf
Dockerfile  text eol=lf

# Templates whose names do not end in a listed extension; without these,
# `* text=auto` plus core.autocrlf=true rewrites them to CRLF on Windows.
config.yaml.example text eol=lf
.env.example        text eol=lf
.gitattributes      text eol=lf
.gitignore          text eol=lf
.dockerignore       text eol=lf

# Binary assets are never converted.
*.png       binary
*.jpg       binary
*.gif       binary
*.ico       binary
*.exe       binary
