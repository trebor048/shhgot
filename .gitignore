# ===========================================================================
# shhgit .gitignore
# ===========================================================================

# --- Binaries & build artifacts -------------------------------------------
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
*.err

# Linux binaries (no extension on Linux)
/shhgit
shhgit-linux-*
shhgit_linux-*

build/
vendor/
dist/

# --- Secrets & local config — NEVER COMMIT --------------------------------
# .env is created by `cp .env.example .env`; it can hold an AI provider key and
# a Cloudflare tunnel token. The template stays tracked.
.env
.env.*
!.env.example

# Local config. The real config.yaml holds GitHub PATs and Discord webhooks.
config.yaml
config.yaml.bak
config.yaml.*
!config.yaml.example
config.clean.yaml
config_backup.yaml
config_clean.yaml
config_enhanced.yaml
config.cleaned.sanitized.yaml

# --- Scan output (may contain live credentials) ---------------------------
remote_connection_strings.txt
found_keys_*.txt

# --- Logs -----------------------------------------------------------------
logs/
*.log

# --- Backups / scratch ----------------------------------------------------
*.bak
*.orig
*.rej
_*.txt
_*.html
*~
*.swp
*.swo
.DS_Store

# --- IDE / editor ---------------------------------------------------------
.vscode/
.idea/
workspace.code-workspace

# --- Leftovers from the removed web frontend ------------------------------
# frontend/ is not tracked any more (the refactor deleted its sources), but an
# npm install and a build can still be sitting on disk, and `git add -A` would
# happily commit all 8,700-odd files of them. Keep both guarded.
node_modules/
/frontend/

# --- Local agent-harness state (never publish your own use) ---------------
# Session replays, trajectories, evidence, plans and local workflow config.
# These are personal tooling state, not shhgit content.
.swarm/
.opencode/
.superpowers/

# AI review workspace (job data, clones, archives, extracted secrets)
ai_review/
yamlcheck/

# Accidental recursive copy of the repo (from a bad `cp`/`scp` invocation)
.../
