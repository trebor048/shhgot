# ===========================================================================
# shhgit environment overrides — OPTIONAL
# ===========================================================================
# Deployment variables and optional AI-review credentials. Everything else
# (GitHub tokens, webhooks, signatures, performance settings) lives in
# config.yaml. Do not put GitHub tokens in this file.
#
#   cp .env.example .env
# ===========================================================================

# Host port the dashboard is published on (docker compose).
SHHGIT_PORT=8080

# Optional. AI-review provider credentials. These are PER-FIELD FALLBACKS BELOW
# the dashboard's Settings tab: whatever you save there wins, and these are only
# consulted for fields the saved settings leave blank.
#
# Full list: SHHGIT_AI_PROVIDER, SHHGIT_AI_API_KEY, SHHGIT_AI_BASE_URL,
# SHHGIT_AI_MODEL, plus per-provider SHHGIT_AI_<PROVIDER>_{API_KEY,BASE_URL,MODEL}.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Optional. Cloudflare Tunnel token, needed only for:
#   docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=
