# ===========================================================================
# shhgit environment overrides — OPTIONAL
# ===========================================================================
# Only three environment variables affect shhgit. Everything else (GitHub
# tokens, webhooks, signatures, performance and AI-review settings) lives in
# config.yaml. Do not put tokens in this file.
#
#   cp .env.example .env
# ===========================================================================

# Host port the dashboard is published on (docker compose).
SHHGIT_PORT=8080

# Optional. DeepSeek API key for the AI-review chat. Equivalent to setting
# ai_review.deepseek_api_key in config.yaml; this wins if both are present.
DEEPSEEK_API_KEY=

# Optional. Cloudflare Tunnel token, needed only for:
#   docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=
